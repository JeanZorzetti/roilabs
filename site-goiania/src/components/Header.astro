---
// Header do site Goiânia. Links internos do polo.
import CartCount from './CartCount.astro';
import FavCount from './FavCount.astro';
import MiniCart from './MiniCart.astro';
import SiteSearch from './SiteSearch.astro';
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="ROI Labs Goiânia, página inicial">
      <img class="brand__logo" src="/roilabs-logo.png" alt="ROI Labs" width="253" height="48" />
    </a>
    <nav class="nav" aria-label="Principal">
      <a class="nav__link" href="/fitas/">Fitas adesivas</a>
      <a class="nav__link" href="/porcelanato/">Porcelanato</a>
      <a class="nav__link" href="/inspire-se/">Inspire-se</a>
      <a class="nav__link" href="https://roilabs.com.br" target="_blank" rel="noopener">ROI Labs</a>
      <FavCount />
      <CartCount />
    </nav>
  </div>
  <MiniCart />
  <SiteSearch />
</header>
