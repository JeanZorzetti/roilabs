// ROI Labs admin — Postgres (EasyPanel). snake_case tables via @@map (owner convention).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Candidaturas = leads do form do site. status: novo | curadoria | aprovado | recusado
model Candidatura {
  id        String   @id @default(cuid())
  nome      String
  empresa   String
  whatsapp  String
  cidade    String?
  categoria String?
  site      String?
  mensagem  String?
  status    String   @default("novo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parceiros Parceiro[]

  @@index([status])
  @@map("candidaturas")
}

// Lead de consumidor vindo do formulário das páginas pSEO de porcelanato.
model LeadConsumidor {
  id          String   @id @default(cuid())
  nome        String
  whatsapp    String
  produto     String?
  pagina      String?
  mensagem    String?
  consentLGPD Boolean  @default(false) @map("consent_lgpd")
  status      String   @default("novo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("leads_consumidor")
}

// Pedido de e-commerce de porcelanato (site Goiânia). pago = reserva até o fornecedor confirmar.
model Pedido {
  id                String   @id @default(cuid())
  nome              String
  whatsapp          String
  email             String?
  entrega           String // retirada | entrega | a_combinar
  compradorDoc      String?  @map("comprador_doc") // CPF/CNPJ normalizado (só dígitos); opcional no B2C (010)
  cep               String?
  frete             Decimal? @db.Decimal(10, 2) // null = a combinar (FR-016)
  cupomCodigo       String?  @map("cupom_codigo") // snapshot do cupom aplicado; null se sem cupom
  desconto          Decimal? @db.Decimal(10, 2) // desconto recalculado no servidor (só sobre produto)
  total             Decimal  @db.Decimal(10, 2) // produto − desconto + frete (recalculado no servidor)
  statusPagamento   String   @default("pendente") @map("status_pagamento") // pendente | pago | reembolsado
  statusFulfillment String   @default("aguardando") @map("status_fulfillment") // aguardando | confirmado | reembolsado
  mpPreferenceId    String?  @map("mp_preference_id")
  mpPaymentId       String?  @unique @map("mp_payment_id") // chave de idempotência do webhook (D4)
  consent           Boolean  @default(false)

  // 011: qual vertical o pedido é — decide qual relação de itens ler e qual modelo de frete
  // se aplica. Um pedido tem itens de UM só vertical (FR-028). Backfill explícito em
  // scripts/migrate-011-backfill.mjs: o @default não reescreve linha já gravada.
  vertical    String  @default("porcelanato") // 'porcelanato' | 'fitas'
  // Por que o frete ficou "a combinar": 'cep_nao_atendido' (operação normal) vs
  // 'falha_tecnica' (incidente, dispara alerta). Anulável DE PROPÓSITO — NOT NULL aqui
  // quebraria `where: { freteMotivo: null }` (mesma landmine da 010).
  freteMotivo String? @map("frete_motivo")

  itens     ItemPedido[]
  itensFita ItemPedidoFita[]
  negocios  NegocioOriginado[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([statusPagamento])
  @@map("pedidos")
}

model ItemPedido {
  id       String  @id @default(cuid())
  pedidoId String  @map("pedido_id")
  slug     String
  caixas   Int
  m2       Decimal @db.Decimal(10, 2)
  precoM2  Decimal @db.Decimal(10, 2) @map("preco_m2") // snapshot do preço/m² na compra
  subtotal Decimal @db.Decimal(10, 2)

  // Snapshot congelado quando o pedido vira 'pago' (US4). NULL = pedido anterior à feature.
  pisoSnapshot              Decimal? @db.Decimal(10, 2) @map("piso_snapshot")
  modalidadeSnapshot        String?  @map("modalidade_snapshot") // 'wl'|'intermediacao'
  comissaoSnapshot          Decimal? @db.Decimal(6, 4) @map("comissao_snapshot")
  aliqIntermediacaoSnapshot Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao_snapshot")
  aliqWLSnapshot            Decimal? @db.Decimal(6, 4) @map("aliq_wl_snapshot")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido")
}

// Item de pedido de FITA (011). Tabela nova, na unidade certa (rolo) — ItemPedido é de
// porcelanato e não é tocado (FR-003). Sem linha antiga ⇒ sem risco de backfill.
model ItemPedidoFita {
  id        String  @id @default(cuid())
  pedidoId  String  @map("pedido_id")
  slug      String
  rolos     Int
  precoRolo Decimal @db.Decimal(10, 2) @map("preco_rolo") // snapshot do unitário da faixa aplicada
  faixaMin  Int     @map("faixa_min") // faixa aplicada — sem isto um pedido antigo não permite
  faixaMax  Int?    @map("faixa_max") // reconstruir POR QUE cobrou aquele unitário
  subtotal  Decimal @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido_fita")
}

// Parâmetros dos centros de custo (global + linha). Campos nullable = herda a camada acima.
model ParametroCentroCusto {
  id                String   @id @default(cuid())
  escopo            String // 'global' | 'linha'
  chave             String? // null no global; nome da linha quando escopo='linha'
  markup            Decimal? @db.Decimal(6, 4)
  comissao          Decimal? @db.Decimal(6, 4)
  aliqIntermediacao Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao")
  aliqWL            Decimal? @db.Decimal(6, 4) @map("aliq_wl")
  cenario           String? // só no global: 'conservador'|'base'|'otimista'|'ajustado'
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([escopo, chave])
  @@map("parametro_centro_custo")
}

// Config por SKU: piso real, modalidade-alvo, overrides de parâmetro. Tudo opcional.
model SkuConfig {
  id                String   @id @default(cuid())
  slug              String   @unique
  linha             String? // nome de uma ParametroCentroCusto escopo=linha
  piso              Decimal? @db.Decimal(10, 2) // atacado real /m²; ausente = estimado por markup
  modalidadeAlvo    String?  @map("modalidade_alvo") // 'wl'|'intermediacao'; ausente = Intermediação
  markup            Decimal? @db.Decimal(6, 4)
  comissao          Decimal? @db.Decimal(6, 4)
  aliqIntermediacao Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao")
  aliqWL            Decimal? @db.Decimal(6, 4) @map("aliq_wl")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("sku_config")
}

// Cupons de desconto — migra o knob CUPONS de lib/cupons.ts. Desconto SEMPRE sobre o
// subtotal do produto (nunca frete); servidor é a autoridade única (validado no display
// E re-validado no checkout).
model Cupom {
  id             String    @id @default(cuid())
  codigo         String    @unique // armazenado em MAIÚSCULAS
  tipo           String // 'percentual' | 'fixo'
  valor          Decimal   @db.Decimal(10, 2) // percentual 0–100 · fixo BRL
  validadeInicio DateTime? @map("validade_inicio") @db.Date
  validadeFim    DateTime? @map("validade_fim") @db.Date
  minimo         Decimal?  @db.Decimal(10, 2)
  ativo          Boolean   @default(true)
  // 011: em qual vertical o cupom vale. Ausência de escopo NÃO é 'ambos' (FR-037) — senão
  // todo cupom vigente passa a valer para fita por omissão e drena a margem do parceiro.
  escopo         String    @default("porcelanato") // 'porcelanato' | 'fitas' | 'ambos'
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("cupons")
}

// Mapa de cadeiras — espelha o seats[] hard-coded do site (niche/status/open).
model Cadeira {
  id        String   @id @default(cuid())
  niche     String
  status    String
  open      Boolean  @default(false)
  ordem     Int      @default(0)
  polo      String   @default("Goiânia")
  updatedAt DateTime @updatedAt @map("updated_at")

  parceiros Parceiro[]

  @@map("cadeiras")
}

// Parceiro (loja/prestador) que recebe repasses de uma cadeira/nicho. Camada 007.
// estagio: sondagem | ativa | riscada | pausada. contratoEm setado ⇒ ocupa a cadeira (derivado).
model Parceiro {
  id             String    @id @default(cuid())
  nome           String
  whatsapp       String?
  email          String?
  cpfCnpj        String?   @map("cpf_cnpj") // obrigatório só para faturar (cliente Asaas)
  cidade         String?
  nicho          String // derivado da Cadeira escolhida na criação
  polo           String    @default("Goiânia")
  cadeiraId      String?   @map("cadeira_id")
  candidaturaId  String?   @map("candidatura_id")
  estagio        String    @default("sondagem")
  // ponytail: comissaoPct deprecada (não lida no cálculo desde a 010); dropar num db push futuro se incomodar.
  comissaoPct         Decimal? @db.Decimal(6, 4) @map("comissao_pct") // DEPRECADO — substituído pelas duas taxas abaixo
  comissaoAquisicao   Decimal? @db.Decimal(6, 4) @map("comissao_aquisicao") // fração [0,1]; 1ª compra ganha do cliente
  comissaoRecorrencia Decimal? @db.Decimal(6, 4) @map("comissao_recorrencia") // fração [0,1]; compras seguintes
  contratoEm     DateTime? @db.Date @map("contrato_em")
  asaasCustomerId String?  @map("asaas_customer_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cadeira     Cadeira?          @relation(fields: [cadeiraId], references: [id])
  candidatura Candidatura?      @relation(fields: [candidaturaId], references: [id])
  negocios    NegocioOriginado[]
  faturas     FaturaSuccessFee[]

  @@index([estagio])
  @@index([cadeiraId])
  @@map("parceiros")
}

// Negócio originado: um Pedido pago repassado a um Parceiro. Camada 007.
// estagio: repassado | aceito | ganho | perdido. Repasse único por pedido (regra na rota, FR-004a).
model NegocioOriginado {
  id             String   @id @default(cuid())
  pedidoId       String   @map("pedido_id")
  parceiroId     String   @map("parceiro_id")
  valor          Decimal  @db.Decimal(10, 2) // snapshot: total do pedido − frete (valor de produto)
  estagio        String   @default("repassado")
  faturavel      Boolean  @default(true) // isenção pontual ⇒ false
  isencaoMotivo  String?  @map("isencao_motivo")
  // Snapshot congelado na criação do negócio (010, FR-005).
  clienteDoc     String?  @map("cliente_doc") // CPF/CNPJ normalizado do comprador; null = sem doc → aquisição
  classificacao  String?  // aquisicao | recorrencia | legado (backfill)
  taxaAplicada   Decimal  @db.Decimal(6, 4) @map("taxa_aplicada") // fração [0,1] cobrada neste negócio (NOT NULL — T021)
  faturaId       String?  @map("fatura_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pedido   Pedido             @relation(fields: [pedidoId], references: [id])
  parceiro Parceiro           @relation(fields: [parceiroId], references: [id])
  fatura   FaturaSuccessFee?  @relation(fields: [faturaId], references: [id])

  @@index([parceiroId])
  @@index([estagio])
  @@index([pedidoId])
  @@index([parceiroId, clienteDoc]) // achar negócios anteriores do mesmo cliente+parceiro (classificação)
  @@map("negocios_originados")
}

// Fatura mensal de success fee por parceiro + cobrança Asaas. Camada 007.
model FaturaSuccessFee {
  id             String   @id @default(cuid())
  parceiroId     String   @map("parceiro_id")
  competencia    String // 'YYYY-MM'
  base           Decimal  @db.Decimal(12, 2) // Σ valor dos negócios incluídos
  valor          Decimal  @db.Decimal(12, 2) // Σ (negócio.valor × negócio.taxaAplicada) — soma por negócio (010)
  status         String   @default("emitida") // emitida | paga | erro
  asaasPaymentId String?  @unique @map("asaas_payment_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parceiro Parceiro           @relation(fields: [parceiroId], references: [id])
  negocios NegocioOriginado[]

  @@unique([parceiroId, competencia])
  @@map("faturas_success_fee")
}
