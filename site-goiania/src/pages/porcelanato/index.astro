---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import { pages } from '../../data/porcelanato';
import { produtos } from '../../data/produtos';
import { guias } from '../../data/guias';

const SITE = Astro.site?.href.replace(/\/$/, '') ?? 'https://goiania.roilabs.com.br';

// Agrupar por tipo para exibição organizada
const byTipo = pages.reduce<Record<string, typeof pages>>((acc, p) => {
  const key = p.tipo;
  (acc[key] = acc[key] ?? []).push(p);
  return acc;
}, {});

// Hub: breadcrumb + ItemList das páginas de categoria da malha + Product com
// AggregateOffer do catálogo inteiro (faixa real de R$/m² computada no build,
// mesma mecânica do guia quanto-custa) — é a página que disputa a âncora
// "porcelanato goiânia" e ganha faixa de preço no rich result.
const precos = produtos.map((p) => p.atributos.preco).filter((v) => v > 0);
const jsonLdNodes = [
  {
    '@type': 'Product',
    name: 'Porcelanato em Goiânia',
    description:
      'Catálogo de porcelanato no polo de Goiânia: amadeirado, marmorizado, acetinado, polido e antiderrapante, com preço por m² e venda por caixa fechada.',
    brand: { '@type': 'Brand', name: 'ROI Labs — Polo Goiânia' },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'BRL',
      lowPrice: Math.min(...precos),
      highPrice: Math.max(...precos),
      offerCount: precos.length,
      url: `${SITE}/porcelanato/`,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Porcelanato', item: `${SITE}/porcelanato/` },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Guias de porcelanato em Goiânia',
    numberOfItems: pages.length,
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.titulo,
      url: `${SITE}/porcelanato/${p.slug}/`,
    })),
  },
];
---

<Base
  title="Porcelanato em Goiânia — Guias por Tipo e Ambiente | ROI Labs"
  description="Explore todos os guias de porcelanato para Goiânia: amadeirado, marmorizado, acetinado, antiderrapante, por ambiente e dimensão. Curadoria ROI Labs."
  ogImage="/open-graph/porcelanato/index.png"
  jsonLdNodes={jsonLdNodes}
>
  <Header />

  <main>
    <section class="section">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Localização">
          <a href="/">Início</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <span aria-current="page">Porcelanato</span>
        </nav>

        <div class="section__head">
          <span class="eyebrow" style="color:var(--hivis);display:block;margin-bottom:1rem;">Guias de porcelanato</span>
          <h1>Porcelanato em Goiânia</h1>
          <p class="section__lead" style="color:var(--d-muted);">
            {pages.length} guias completos por tipo, ocasião, dimensão e acabamento —
            com atributos técnicos, como escolher e FAQ para cada perfil de compra.
          </p>
        </div>

        <div style="margin-top:3rem;">
          <h2 style="font-size:clamp(1.2rem,2vw,1.6rem);margin-bottom:1rem;">Ainda decidindo? Comece pelos guias de decisão</h2>
          <div class="pseo-index-grid">
            {guias.map((g) => (
              <a href={`/guia/${g.slug}/`} class="pseo-index-card">
                <div class="pseo-index-card__title">{g.titulo}</div>
                <div class="pseo-index-card__meta">guia de decisão</div>
              </a>
            ))}
            <a href="/calculadora/" class="pseo-index-card">
              <div class="pseo-index-card__title">Calculadora: quantas caixas comprar?</div>
              <div class="pseo-index-card__meta">ferramenta grátis</div>
            </a>
          </div>
        </div>

        <div class="pseo-index-grid" style="margin-top:3rem;">
          {pages.map((p) => (
            <a href={`/porcelanato/${p.slug}/`} class="pseo-index-card">
              <div class="pseo-index-card__title">{p.titulo.replace(/ em Goiânia.*/, '')}</div>
              <div class="pseo-index-card__meta">
                {p.tipo}{p.ocasiao ? ` · ${p.ocasiao}` : ''}
                {p.atributos.dimensao ? ` · ${p.atributos.dimensao}` : ''}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {produtos.length > 0 && (
      <section class="section section--light">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow" style="display:block;margin-bottom:1rem;">Catálogo</span>
            <h2>{produtos.length} produtos disponíveis em Goiânia</h2>
            <p class="section__lead">
              Modelos reais de fornecedores do polo — com dimensão, acabamento e preço de referência.
            </p>
          </div>
          <div class="prod-grid">
            {produtos.map((prod) => <ProdutoCard produto={prod} />)}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Base>
