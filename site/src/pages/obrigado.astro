---
import Base from '../layouts/Base.astro';
---

<Base
  title="Candidatura recebida — ROI Labs"
  description="Recebemos sua candidatura à cadeira de Goiânia."
  noindex
>
  <main class="thanks">
    <div class="wrap thanks__inner">
      <span class="eyebrow thanks__eyebrow">Candidatura recebida</span>
      <h1>Sua empresa entrou na curadoria.</h1>
      <p class="thanks__lead">
        Vamos avaliar o fit com a cadeira de revestimentos de Goiânia e responder
        em até 48h úteis — no e-mail ou WhatsApp que você deixou.
      </p>
      <a class="btn btn--ghost" href="/">Voltar ao início</a>
    </div>
  </main>
</Base>

<script is:inline>
  // Conversion: reaching /obrigado only happens after the form 303 — race-free vs. tracking the submit.
  if (!sessionStorage.getItem('hm_conv_candidatura')) {
    sessionStorage.setItem('hm_conv_candidatura', '1');
    window.addEventListener('load', function () {
      if (window.himetrica) window.himetrica.track('candidatura_convertida', { page: '/obrigado' });
    });
  }
</script>
