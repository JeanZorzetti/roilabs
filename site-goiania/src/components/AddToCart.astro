---
// Client island: enter the job's m² → see whole closed boxes → add to the cart.
// Sits next to the WhatsApp CTA on the product page (FR-001). Two coexisting modes:
// direct metragem, or the room-by-room simulator (SimuladorM2) — toggled, never replaced.
import SimuladorM2 from './SimuladorM2.astro';
interface Props {
  slug?: string;
  m2Caixa?: number;
  preco?: number;
  // Modo "peça" (015 T015): variação de tamanho/cor. O sku é dinâmico — lido em tempo
  // real do #sv-sku-atual que o SeletorVariacao mantém, nunca fixado em build.
  cadeira?: string;
  skuInicial?: string;
}
const { slug, m2Caixa, preco, cadeira, skuInicial } = Astro.props;
const modoPeca = Boolean(cadeira && skuInicial);
---
{modoPeca ? (
  <div class="add-cart add-cart--peca" data-cadeira={cadeira}>
    <label class="add-cart__label" for="add-cart-peca-qtd">Quantidade</label>
    <div class="add-cart__row">
      <input
        id="add-cart-peca-qtd"
        class="add-cart__input add-cart__input--peca"
        type="number"
        inputmode="numeric"
        min="1"
        step="1"
        value="1"
      />
      <button type="button" class="btn btn--primary add-cart__btn add-cart__btn--peca">Adicionar ao carrinho</button>
    </div>
    <p class="add-cart__preview add-cart__preview--peca" aria-live="polite"></p>
  </div>
) : (
  <div class="add-cart" data-slug={slug} data-m2caixa={m2Caixa} data-preco={preco}>
    <div class="add-cart__modes" role="tablist">
      <button type="button" class="add-cart__mode is-active" data-mode="direto" aria-selected="true">Tenho a metragem</button>
      <button type="button" class="add-cart__mode" data-mode="ambiente" aria-selected="false">Calcular por ambiente</button>
    </div>

    <div class="add-cart__pane" data-pane="direto">
      <label class="add-cart__label" for={`m2-${slug}`}>Metragem da obra (m²)</label>
      <div class="add-cart__row">
        <input
          id={`m2-${slug}`}
          class="add-cart__input"
          type="number"
          inputmode="decimal"
          min="0.1"
          step="0.1"
          placeholder="ex: 25"
        />
        <button type="button" class="btn btn--primary add-cart__btn">Adicionar ao carrinho</button>
      </div>
      <p class="add-cart__preview" aria-live="polite"></p>
    </div>

    <div class="add-cart__pane" data-pane="ambiente" hidden>
      <SimuladorM2 slug={slug} m2Caixa={m2Caixa} preco={preco} />
    </div>
  </div>
)}

<style>
  .add-cart { margin-bottom: 1.2rem; }
  /* Adaptive: AddToCart renders on a dark product page and inside a light category
     section. currentColor + color-mix keep contrast correct on both. */
  .add-cart__label {
    display: block;
    font-size: 0.85rem;
    color: inherit;
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }
  .add-cart__row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .add-cart__input {
    flex: 1 1 8rem;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, currentColor 6%, transparent);
    color: inherit;
    font: inherit;
  }
  .add-cart__input::placeholder { color: inherit; opacity: 0.45; }
  .add-cart__input:focus-visible { outline: 2px solid var(--hivis); outline-offset: 1px; }
  .add-cart__btn { flex: 0 0 auto; white-space: nowrap; }
  .add-cart__preview { margin: 0.7rem 0 0; min-height: 1.3em; font-size: 0.9rem; color: var(--hivis); font-weight: 600; }
  .add-cart__preview a { color: var(--hivis); font-weight: 700; text-decoration: underline; }
  .add-cart__modes { display: inline-flex; gap: 0.3rem; margin-bottom: 0.9rem; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 999px; padding: 0.2rem; }
  .add-cart__mode { background: none; border: 0; color: inherit; opacity: 0.7; cursor: pointer; font: inherit; font-size: 0.85rem; padding: 0.35rem 0.85rem; border-radius: 999px; }
  .add-cart__mode.is-active { background: var(--hivis); color: #fff; opacity: 1; font-weight: 600; }
</style>

<script>
  import { m2ParaCaixas, addItem, resolveCart } from '../lib/cart';

  function brl(n: number) {
    return n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  document.querySelectorAll<HTMLElement>('.add-cart:not(.add-cart--peca)').forEach((root) => {
    const slug = root.dataset.slug!;
    const m2Caixa = Number(root.dataset.m2caixa);
    const preco = Number(root.dataset.preco);
    const input = root.querySelector<HTMLInputElement>('.add-cart__input')!;
    const btn = root.querySelector<HTMLButtonElement>('.add-cart__btn')!;
    const preview = root.querySelector<HTMLElement>('.add-cart__preview')!;

    function caixasFromInput() {
      const m2 = parseFloat(input.value.replace(',', '.'));
      if (!(m2 > 0)) return 0;
      return m2ParaCaixas(m2, m2Caixa);
    }

    function refresh() {
      const caixas = caixasFromInput();
      if (caixas === 0) { preview.textContent = ''; return; }
      const cobertos = (caixas * m2Caixa).toFixed(2).replace('.', ',');
      preview.textContent = `≈ ${caixas} caixa(s) · ${cobertos} m² cobertos · ${brl(caixas * m2Caixa * preco)}`;
    }

    input.addEventListener('input', refresh);
    btn.addEventListener('click', () => {
      const caixas = caixasFromInput();
      if (caixas === 0) { input.focus(); return; }
      addItem('porcelanato', slug, caixas);
      const res = resolveCart();
      preview.innerHTML = `Adicionado! <a href="/carrinho/">Ver carrinho (${res.lines.length})</a>`;
      input.value = '';
    });
  });

  // Mode toggle: direct m² ⇄ room simulator (both panes coexist).
  document.querySelectorAll<HTMLElement>('.add-cart:not(.add-cart--peca)').forEach((root) => {
    const modes = root.querySelectorAll<HTMLButtonElement>('.add-cart__mode');
    modes.forEach((mode) =>
      mode.addEventListener('click', () => {
        modes.forEach((m) => {
          const on = m === mode;
          m.classList.toggle('is-active', on);
          m.setAttribute('aria-selected', String(on));
        });
        root.querySelectorAll<HTMLElement>('.add-cart__pane').forEach((pane) => {
          pane.hidden = pane.dataset.pane !== mode.dataset.mode;
        });
      }),
    );
  });

  // Modo "peça" (015): sku lido AO VIVO do SeletorVariacao no clique — nunca guardado
  // em estado local, então não há corrida com o script do seletor (qualquer ordem de
  // carregamento funciona, e a leitura reflete sempre a combinação atual).
  document.querySelectorAll<HTMLElement>('.add-cart--peca').forEach((root) => {
    const cadeira = root.dataset.cadeira!;
    const input = root.querySelector<HTMLInputElement>('.add-cart__input--peca')!;
    const btn = root.querySelector<HTMLButtonElement>('.add-cart__btn--peca')!;
    const preview = root.querySelector<HTMLElement>('.add-cart__preview--peca')!;

    btn.addEventListener('click', () => {
      const skuEl = document.getElementById('sv-sku-atual') as HTMLInputElement | null;
      const sku = skuEl?.value;
      const esgotado = skuEl?.dataset.esgotado === 'true';
      if (!sku || esgotado) {
        preview.textContent = 'Escolha uma combinação disponível antes de adicionar.';
        return;
      }
      const qtd = Math.max(1, Math.floor(Number(input.value)) || 1);
      addItem(cadeira, sku, qtd);
      const res = resolveCart();
      preview.innerHTML = `Adicionado! <a href="/carrinho/">Ver carrinho (${res.lines.length})</a>`;
    });
  });
</script>
