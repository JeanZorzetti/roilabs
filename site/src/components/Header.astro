---
// Header compartilhado (home + blog). Links absolutos (/#...) funcionam de qualquer página.
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="ROI Labs, página inicial">
      <img class="brand__logo" src="/roilabs-logo.png" alt="ROI Labs" width="253" height="48" />
    </a>
    <nav class="nav" aria-label="Principal">
      <a class="nav__link" href="/modelo/">Modelo</a>
      <a class="nav__link" href="/#cadeiras">Cadeiras</a>
      <a class="nav__link" href="/#mercado">Mercado</a>
      <a class="nav__link" href="/simulador/">Simulador</a>
      <a class="nav__link" href="/blog/">Blog</a>
      <!-- mobile: os links acima somem abaixo de 720px; este <details> é o menu sem JS -->
      <details class="nav__menu">
        <summary class="nav__toggle">Menu</summary>
        <div class="nav__panel">
          <a href="/modelo/">Modelo</a>
          <a href="/#cadeiras">Cadeiras</a>
          <a href="/#mercado">Mercado</a>
          <a href="/simulador/">Simulador</a>
          <a href="/blog/">Blog</a>
        </div>
      </details>
      <a class="btn btn--primary btn--sm nav__cta" href="/#candidatar">Aplicar</a>
    </nav>
  </div>
</header>
