---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import VistosRecentemente from '../../components/VistosRecentemente.astro';
import { pages } from '../../data/porcelanato';
import { produtos, produtosDaCategoria, imgDisplay } from '../../data/produtos';
import { guias } from '../../data/guias';

const SITE = Astro.site?.href.replace(/\/$/, '') ?? 'https://goiania.roilabs.com.br';

// Agrupar por tipo para exibição organizada
const byTipo = pages.reduce<Record<string, typeof pages>>((acc, p) => {
  const key = p.tipo;
  (acc[key] = acc[key] ?? []).push(p);
  return acc;
}, {});

// Ciclo 14: capa do card sem repetição. Pegar sempre imagens[0] do 1º produto
// da categoria (ciclo 11) fazia várias categorias com o mesmo tipo/tag mostrarem
// a mesma foto (ex.: 14 cards usando a mesma foto de "amadeirado"). Agora cada
// categoria reserva uma foto ainda não usada por nenhuma outra: 1ª passada pega
// produto ainda não mostrado; 2ª passada aceita repetir produto mas com outra
// foto dele; só repete foto de verdade quando a categoria não tem alternativa
// real no catálogo (ex.: "amadeirado" só tem 1 produto — ceiling de estoque, não bug).
const usedCovers = new Set<string>();
const capas = new Map<string, string>();
for (const p of pages) {
  const candidatos = produtosDaCategoria(p.slug, p.tipo);
  if (candidatos.length === 0) continue;
  const fresh = candidatos.find((c) => !usedCovers.has(c.imagens[0]));
  let escolha = fresh?.imagens[0];
  if (!escolha) {
    for (const c of candidatos) {
      escolha = [...c.imagens, ...(c.imagensAmbiente ?? [])].find((img) => !usedCovers.has(img));
      if (escolha) break;
    }
  }
  escolha = escolha ?? candidatos[0].imagens[0];
  usedCovers.add(escolha);
  capas.set(p.slug, escolha);
}
const capaDe = (slug: string) => capas.get(slug);

// Filtros do catálogo (tarefa 6): opções computadas no build a partir dos
// atributos reais; o JS só esconde/reordena os cards já emitidos.
const marcas = [...new Set(produtos.map((p) => p.atributos.marca))].sort();
const formatos = [...new Set(produtos.map((p) => p.atributos.dimensao))].sort();

// Hub: breadcrumb + ItemList das páginas de categoria da malha + Product com
// AggregateOffer do catálogo inteiro (faixa real de R$/m² computada no build,
// mesma mecânica do guia quanto-custa) — é a página que disputa a âncora
// "porcelanato goiânia" e ganha faixa de preço no rich result.
const precos = produtos.map((p) => p.atributos.preco).filter((v) => v > 0);
const jsonLdNodes = [
  {
    '@type': 'Product',
    name: 'Porcelanato em Goiânia',
    description:
      'Catálogo de porcelanato no polo de Goiânia: amadeirado, marmorizado, acetinado, polido e antiderrapante, com preço por m² e venda por caixa fechada.',
    brand: { '@type': 'Brand', name: 'ROI Labs — Polo Goiânia' },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'BRL',
      lowPrice: Math.min(...precos),
      highPrice: Math.max(...precos),
      offerCount: precos.length,
      url: `${SITE}/porcelanato/`,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Porcelanato', item: `${SITE}/porcelanato/` },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Guias de porcelanato em Goiânia',
    numberOfItems: pages.length,
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.titulo,
      url: `${SITE}/porcelanato/${p.slug}/`,
    })),
  },
];
---

<Base
  title="Porcelanato em Goiânia — Guias por Tipo e Ambiente | ROI Labs"
  description="Explore todos os guias de porcelanato para Goiânia: amadeirado, marmorizado, acetinado, antiderrapante, por ambiente e dimensão. Curadoria ROI Labs."
  ogImage="/open-graph/porcelanato/index.png"
  jsonLdNodes={jsonLdNodes}
>
  <Header />

  <main>
    <section class="section">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Localização">
          <a href="/">Início</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <span aria-current="page">Porcelanato</span>
        </nav>

        <div class="section__head">
          <span class="eyebrow" style="color:var(--hivis);display:block;margin-bottom:1rem;">Guias de porcelanato</span>
          <h1>Porcelanato em Goiânia</h1>
          <p class="section__lead" style="color:var(--d-muted);">
            {pages.length} guias completos por tipo, ocasião, dimensão e acabamento —
            com atributos técnicos, como escolher e FAQ para cada perfil de compra.
          </p>
        </div>

        <div style="margin-top:3rem;">
          <h2 style="font-size:clamp(1.2rem,2vw,1.6rem);margin-bottom:1rem;">Ainda decidindo? Comece pelos guias de decisão</h2>
          <div class="pseo-index-grid">
            {guias.map((g) => (
              <a href={`/guia/${g.slug}/`} class="pseo-index-card">
                <div class="pseo-index-card__title">{g.titulo}</div>
                <div class="pseo-index-card__meta">guia de decisão</div>
              </a>
            ))}
            <a href="/calculadora/" class="pseo-index-card">
              <div class="pseo-index-card__title">Calculadora: quantas caixas comprar?</div>
              <div class="pseo-index-card__meta">ferramenta grátis</div>
            </a>
            <a href="/inspire-se/" class="pseo-index-card">
              <div class="pseo-index-card__title">Inspire-se: fotos reais de ambientes</div>
              <div class="pseo-index-card__meta">galeria</div>
            </a>
          </div>
        </div>

        <div class="pseo-index-grid" style="margin-top:3rem;">
          {pages.map((p) => {
            const capa = capaDe(p.slug);
            return (
              <a href={`/porcelanato/${p.slug}/`} class={`pseo-index-card${capa ? ' pseo-index-card--img' : ''}`}>
                {capa && (
                  <div class="pseo-index-card__cover">
                    <img src={imgDisplay(capa)} alt="" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="pseo-index-card__body">
                  <div class="pseo-index-card__title">{p.titulo.replace(/ em Goiânia.*/, '')}</div>
                  <div class="pseo-index-card__meta">
                    {p.tipo}{p.ocasiao ? ` · ${p.ocasiao}` : ''}
                    {p.atributos.dimensao ? ` · ${p.atributos.dimensao}` : ''}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {produtos.length > 0 && (
      <section class="section section--light">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow" style="display:block;margin-bottom:1rem;">Catálogo</span>
            <h2>{produtos.length} produtos disponíveis em Goiânia</h2>
            <p class="section__lead">
              Modelos reais de fornecedores do polo — com dimensão, acabamento e preço de referência.
            </p>
          </div>
          <form class="prod-filtros" id="prod-filtros" aria-label="Filtrar e ordenar catálogo">
            <label>
              <span>Marca</span>
              <select name="marca">
                <option value="">Todas</option>
                {marcas.map((m) => <option value={m}>{m}</option>)}
              </select>
            </label>
            <label>
              <span>Formato</span>
              <select name="formato">
                <option value="">Todos</option>
                {formatos.map((f) => <option value={f}>{f}</option>)}
              </select>
            </label>
            <label>
              <span>Ordenar</span>
              <select name="ordem">
                <option value="">Padrão</option>
                <option value="preco-asc">Menor preço/m²</option>
                <option value="preco-desc">Maior preço/m²</option>
              </select>
            </label>
            <span class="prod-filtros__count" id="prod-count" role="status" aria-live="polite"></span>
            <button type="button" id="prod-limpar" hidden>Limpar filtros</button>
          </form>
          <div class="prod-grid" id="prod-grid">
            {produtos.map((prod) => <ProdutoCard produto={prod} />)}
          </div>
          <p class="prod-vazio" id="prod-vazio" hidden>
            Nenhum produto com essa combinação de marca e formato.
            <a href="/porcelanato/">Limpar filtros</a> ou fale com a gente pelo WhatsApp.
          </p>
        </div>
      </section>
    )}

    <VistosRecentemente />
  </main>

  <Footer />
</Base>

<style>
  .prod-filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .prod-filtros label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .prod-filtros select {
    padding: 0.5rem 0.7rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 8px;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
  }
  .prod-filtros__count {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-left: auto;
  }
  .prod-filtros button {
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 8px;
    background: #fff;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .prod-vazio {
    margin-top: 1rem;
    font-size: 0.95rem;
  }
</style>

<script>
  // Progressive enhancement: sem JS o grid inteiro já está renderizado e os
  // selects não fazem nada. O JS só esconde (display) e reordena (CSS order)
  // cards existentes — nenhum DOM criado, sem gotcha de scoped styles.
  const form = document.getElementById('prod-filtros') as HTMLFormElement | null;
  const grid = document.getElementById('prod-grid');
  if (form && grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.prod-card')];
    const total = cards.length;
    const count = document.getElementById('prod-count')!;
    const vazio = document.getElementById('prod-vazio')!;
    const limpar = document.getElementById('prod-limpar')!;

    const aplicar = () => {
      const marca = (form.elements.namedItem('marca') as HTMLSelectElement).value;
      const formato = (form.elements.namedItem('formato') as HTMLSelectElement).value;
      const ordem = (form.elements.namedItem('ordem') as HTMLSelectElement).value;

      let visiveis = 0;
      for (const c of cards) {
        const ok =
          (!marca || c.dataset.marca === marca) && (!formato || c.dataset.dim === formato);
        c.style.display = ok ? '' : 'none';
        if (ok) visiveis++;
      }

      if (ordem) {
        const dir = ordem === 'preco-desc' ? -1 : 1;
        [...cards]
          .sort((a, b) => dir * (Number(a.dataset.preco) - Number(b.dataset.preco)))
          .forEach((c, i) => (c.style.order = String(i)));
      } else {
        cards.forEach((c) => (c.style.order = ''));
      }

      const ativo = Boolean(marca || formato || ordem);
      count.textContent = ativo ? `${visiveis} de ${total} produtos` : '';
      (limpar as HTMLElement).hidden = !ativo;
      (vazio as HTMLElement).hidden = visiveis > 0;

      const qs = new URLSearchParams();
      if (marca) qs.set('marca', marca);
      if (formato) qs.set('formato', formato);
      if (ordem) qs.set('ordem', ordem);
      history.replaceState(null, '', qs.size ? `?${qs}` : location.pathname);
    };

    // Estado inicial vindo da query string (link compartilhável)
    const qs = new URLSearchParams(location.search);
    for (const nome of ['marca', 'formato', 'ordem']) {
      const sel = form.elements.namedItem(nome) as HTMLSelectElement;
      const v = qs.get(nome);
      if (v && [...sel.options].some((o) => o.value === v)) sel.value = v;
    }
    aplicar();

    form.addEventListener('change', aplicar);
    limpar.addEventListener('click', () => {
      form.reset();
      aplicar();
    });
  }
</script>
