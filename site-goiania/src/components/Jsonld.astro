---
// Emite JSON-LD inline para Product + FAQPage + BreadcrumbList + ItemList.
// Usado pelo template [slug].astro via jsonLdNodes no Base.astro.

import type { PorcelanatoPage } from '../data/porcelanato';
import { produtosDaCategoria, tituloProduto } from '../data/produtos';

interface Props {
  page: PorcelanatoPage;
  site: string;
}

const { page, site } = Astro.props;

export function buildJsonLdNodes(page: PorcelanatoPage, site: string): Record<string, unknown>[] {
  const url = `${site}/porcelanato/${page.slug}/`;

  // AggregateOffer da categoria: faixa de R$/m² computada do catálogo real no build
  // (mesma mecânica do guia quanto-custa — atualiza sozinha a cada publish). Sem ele o
  // Product da malha fica sem offers (warning no GSC) e a categoria não mostra faixa
  // de preço no rich result. lowPrice/highPrice na mesma unidade do produto: R$/m².
  const todos = produtosDaCategoria(page.slug, page.tipo).filter((p) => p.atributos.preco > 0);
  const precos = todos.map((p) => p.atributos.preco);

  const product: Record<string, unknown> = {
    '@type': 'Product',
    name: page.termoAlvo,
    description: page.intro,
    brand: { '@type': 'Brand', name: 'ROI Labs — Polo Goiânia' },
    ...(precos.length > 0 && {
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'BRL',
        lowPrice: Math.min(...precos),
        highPrice: Math.max(...precos),
        offerCount: precos.length,
        url,
      },
    }),
    additionalProperty: [] as Record<string, unknown>[],
  };

  const props = product.additionalProperty as Record<string, unknown>[];
  const a = page.atributos;
  if (a.classeAd !== undefined) props.push({ '@type': 'PropertyValue', name: 'Classe de Abrasão (AD)', value: a.classeAd });
  if (a.acabamento) props.push({ '@type': 'PropertyValue', name: 'Acabamento', value: a.acabamento });
  if (a.dimensao) props.push({ '@type': 'PropertyValue', name: 'Dimensão', value: a.dimensao });
  if (a.m2PorCaixa) props.push({ '@type': 'PropertyValue', name: 'm² por caixa', value: a.m2PorCaixa });
  if (a.ambiente) props.push({ '@type': 'PropertyValue', name: 'Ambiente', value: a.ambiente });
  if (a.antiderrapante !== undefined) props.push({ '@type': 'PropertyValue', name: 'Antiderrapante', value: a.antiderrapante ? 'Sim' : 'Não' });

  const faqPage: Record<string, unknown> = {
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  };

  const tipo = page.tipo.charAt(0).toUpperCase() + page.tipo.slice(1);
  const breadcrumb: Record<string, unknown> = {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: site },
      { '@type': 'ListItem', position: 2, name: 'Porcelanato', item: `${site}/porcelanato/` },
      { '@type': 'ListItem', position: 3, name: tipo, item: url },
    ],
  };

  // ItemList espelha a galeria de produtos da página (mesmo slice(0, 8) do template);
  // cada item aponta pra página de produto, que tem o Product+Offer completo (sku=g:id).
  const galeria = produtosDaCategoria(page.slug, page.tipo).slice(0, 8);
  const itemList: Record<string, unknown> | null =
    galeria.length > 1
      ? {
          '@type': 'ItemList',
          name: `${page.termoAlvo} — opções em Goiânia`,
          numberOfItems: galeria.length,
          itemListElement: galeria.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: tituloProduto(p),
            url: `${site}/porcelanato/produto/${p.slug}/`,
          })),
        }
      : null;

  return itemList ? [product, faqPage, breadcrumb, itemList] : [product, faqPage, breadcrumb];
}
---
