---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  jsonLdNodes?: Record<string, unknown>[];
}

const {
  title = 'ROI Labs — Growth Partner para fornecedores regionais',
  description = 'Construímos sua operação de vendas online sem custo fixo. Você paga só quando vende. Uma cadeira exclusiva por nicho, por polo. Polo 1: Goiânia.',
  ogType = 'website',
  ogImage = '/og-image.jpg',
  jsonLdNodes = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Schema Stacking: um único @graph por página (Organization + WebSite + nós da
// página), ligados por @id — em vez de scripts JSON-LD dispersos.
const ORG_ID = 'https://roilabs.com.br/#org';
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'ROI Labs',
      url: 'https://roilabs.com.br/',
      email: 'parceria@roilabs.com.br',
      description:
        'Growth Partner para fornecedores regionais: operação de vendas online sem custo fixo, remuneração 100% variável. Polo 1: Goiânia, nicho revestimentos/porcelanato.',
      logo: { '@type': 'ImageObject', url: 'https://roilabs.com.br/roilabs-icon.png' },
      areaServed: { '@type': 'City', name: 'Goiânia' },
      slogan: 'Construímos sua venda online. Você paga quando vende.',
      sameAs: [
        'https://www.linkedin.com/company/roi-labs-curadoria/',
        'https://www.instagram.com/roilabs.curadoria/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://roilabs.com.br/#website',
      url: 'https://roilabs.com.br/',
      name: 'ROI Labs',
      inLanguage: 'pt-BR',
      publisher: { '@id': ORG_ID },
    },
    ...jsonLdNodes,
  ],
};

const clarityId = import.meta.env.PUBLIC_CLARITY_ID;
// GA4 do institucional (propriedade roilabs.com.br). Fallback hard-coded de propósito:
// vale sem env na EasyPanel; PUBLIC_GA_ID sobrepõe se um dia precisar trocar.
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-7JD9J2QEDJ';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/roilabs-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#14171d" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Hanken+Grotesk:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    {clarityId && (
      <script is:inline define:vars={{ clarityId }}>
        // Microsoft Clarity (heatmap + session recording) — himetrica diz O QUE converte,
        // Clarity mostra ONDE o funil vaza. Sem PUBLIC_CLARITY_ID no build = no-op.
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",clarityId);
      </script>
    )}

    <script is:inline defer src="https://cdn.himetrica.com/tracker.js" data-api-key="hm_ff2a6a72cb6b63d54c8799d1dad7b24e4263b1e5882f872f"></script>
    <script is:inline>
      // Conversion: any wa.me click on any page = supplier intent (same pattern as site-goiania).
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="https://wa.me/"]') : null;
        if (a && window.himetrica) window.himetrica.track('whatsapp_click', { page: location.pathname });
      });
      // First-touch attribution: 1ª página de entrada (query preserva UTMs) + referrer
      // externo, gravados uma única vez. O form de candidatura consome via input[name=origem].
      try {
        if (!localStorage.rlft) {
          var ref = '';
          try { ref = document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).host : ''; } catch (_) {}
          localStorage.rlft = (location.pathname + location.search + (ref ? ' ← ' + ref : '')).slice(0, 300);
        }
      } catch (_) {}
      document.addEventListener('DOMContentLoaded', function () {
        var v = '';
        try { v = localStorage.rlft || ''; } catch (_) {}
        if (!v) return;
        document.querySelectorAll('input[name="origem"]').forEach(function (i) { i.value = v; });
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
