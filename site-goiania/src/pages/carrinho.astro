---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// O motor (013): carrinho único, resolvido no cliente.
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.roilabs.com.br';
const action = `${appUrl}/api/pedidos`;
const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? '5562993265713';
---

<Base
  title="Carrinho | ROI Labs"
  description="Revise seus itens, ajuste quantidades, aplique cupom e finalize o pagamento online de forma segura."
>
  <Header />

  <main class="section" data-app-url={appUrl}>
    <div class="wrap cart-wrap">
      <h1 class="cart-title" style="font-size:clamp(1.8rem,4vw,2.6rem);margin-bottom:0.4rem;">Seu carrinho</h1>
      <p class="cart-desc" style="color:var(--d-muted);margin-bottom:2rem;">Pagamento online seguro.</p>

      <div class="cart-err" role="alert" hidden></div>

      <!-- Loading state (cleared after the first client render) -->
      <div class="cart-loading">Carregando seu carrinho…</div>

      <!-- Failure state (render threw) -->
      <div class="cart-fail" role="alert" hidden>
        <p>Não conseguimos montar seu carrinho.</p>
        <button type="button" class="btn btn--primary cart-fail__retry">Tentar de novo</button>
      </div>

      <!-- Empty state -->
      <div class="cart-empty" hidden>
        <p>Seu carrinho está vazio.</p>
      </div>

      <div class="cart-grid" hidden>
        <!-- Items -->
        <section class="cart-items" aria-label="Itens do carrinho">
          <ul class="cart-list"></ul>
          <div class="cart-actions">
            <button type="button" class="btn btn--primary cart-whats" data-whats={whatsapp}>
              Receber orçamento no WhatsApp
            </button>
            <p class="cart-whats__note">Compra consultiva? Mandamos seu carrinho pro nosso especialista — sem compromisso.</p>
            <form class="cart-callback" hidden>
              <p class="cart-callback__title">Se preferir, deixe seu WhatsApp que nosso especialista te chama:</p>
              <div class="cart-callback__row">
                <input type="tel" name="cb-whatsapp" maxlength="40" inputmode="tel" placeholder="(62) 9xxxx-xxxx" required aria-label="Seu WhatsApp" />
                <button type="submit" class="btn btn--ghost">Me chama</button>
              </div>
              <label class="cart-callback__consent">
                <input type="checkbox" required />
                <span>Autorizo contato conforme a <a href="https://roilabs.com.br/privacidade" target="_blank" rel="noopener" style="color:var(--hivis)">Política de Privacidade</a>. (LGPD)</span>
              </label>
              <p class="cart-callback__msg" aria-live="polite"></p>
            </form>
            <button type="button" class="cart-share">🔗 Salvar / compartilhar carrinho</button>
            <button type="button" class="cart-share cart-orc">📄 Abrir como orçamento (PDF)</button>
            <p class="cart-share__msg" aria-live="polite"></p>
          </div>
        </section>

        <!-- Checkout form -->
        <aside class="cart-checkout">
          <form id="checkout-form" method="POST" action={action} novalidate>
            <div class="form__hp" aria-hidden="true" style="position:absolute;left:-9999px;">
              <input tabindex="-1" autocomplete="off" name="botcheck" />
            </div>
            <!-- O cart envia a si mesmo completo para o server -->
            <input type="hidden" name="itens" />
            <input type="hidden" name="cadeira" />
            <input type="hidden" name="vertical" /> <!-- Legado mantido temporariamente -->
            <input type="hidden" name="origin" />
            <input type="hidden" name="cupom" />

            <h2 style="font-size:1.2rem;margin:0 0 1rem;">Seus dados</h2>
            <div class="field field--req">
              <label for="ck-nome">Nome</label>
              <input id="ck-nome" type="text" name="nome" maxlength="200" placeholder="Seu nome completo" required />
            </div>
            <div class="field field--req">
              <label for="ck-whatsapp">WhatsApp</label>
              <input id="ck-whatsapp" type="tel" name="whatsapp" maxlength="40" placeholder="(62) 9xxxx-xxxx" required />
            </div>
            <div class="field">
              <label for="ck-email">E-mail (opcional)</label>
              <input id="ck-email" type="email" name="email" maxlength="200" placeholder="voce@email.com" />
            </div>
            <div class="field cart-doc">
              <label for="ck-doc">CPF ou CNPJ <span class="cart-doc-req" style="color:var(--hivis)">(obrigatório)</span></label>
              <input id="ck-doc" type="text" name="compradorDoc" maxlength="20" inputmode="numeric" placeholder="somente números" />
            </div>

            <div class="cart-entrega-section">
              <h2 style="font-size:1.2rem;margin:1.6rem 0 1rem;">Entrega</h2>
              <label class="radio-row">
                <input type="radio" name="entrega" value="retirada" checked />
                <span>Retirar no fornecedor <strong>(grátis)</strong></span>
              </label>
              <label class="radio-row">
                <input type="radio" name="entrega" value="entrega" />
                <span>Entrega no meu endereço</span>
              </label>
              <div class="field cart-cep" hidden style="margin-top:0.8rem;">
                <label for="ck-cep">CEP de entrega</label>
                <div style="display:flex; gap:0.5rem;">
                  <input id="ck-cep" type="text" name="cep" maxlength="12" inputmode="numeric" placeholder="74000-000" style="flex:1" />
                  <button type="button" class="btn btn--ghost cart-cep__calc" hidden>Calcular</button>
                </div>
                <p class="cart-cep__note" style="font-size:0.82rem;color:var(--d-muted);margin:0.4rem 0 0;"></p>
              </div>
            </div>

            <h2 style="font-size:1.2rem;margin:1.6rem 0 1rem;">Cupom</h2>
            <div class="cart-coupon">
              <div class="cart-coupon__row">
                <input id="ck-cupom" type="text" maxlength="40" placeholder="Ex: OBRA10" autocapitalize="characters" aria-label="Código do cupom" />
                <button type="button" class="btn btn--ghost cart-coupon__apply">Aplicar</button>
              </div>
              <p class="cart-coupon__msg" aria-live="polite"></p>
            </div>

            <div class="cart-summary">
              <div class="cart-summary__row"><span>Produtos</span><span class="cart-sum-produto">—</span></div>
              <p class="cart-cliche-nota" hidden><strong>Atenção:</strong> Se você não for cliente recorrente dessa arte, uma taxa de clichê (R$ 80) será adicionada na página de pagamento.</p>
              <div class="cart-summary__row cart-sum-desconto-row" hidden><span>Desconto</span><span class="cart-sum-desconto">—</span></div>
              <div class="cart-summary__row cart-sum-frete-row"><span>Frete</span><span class="cart-sum-frete">Grátis</span></div>
              <div class="cart-summary__row cart-sum-prazo-row" hidden><span>Prazo</span><span class="cart-sum-prazo">—</span></div>
              <div class="cart-summary__row cart-summary__total"><span>Total</span><span class="cart-sum-total">—</span></div>
            </div>

            <label class="consent-field">
              <input type="checkbox" name="consent" value="1" required />
              <span>
                Autorizo o uso dos meus dados conforme a
                <a href="https://roilabs.com.br/privacidade" target="_blank" rel="noopener" style="color:var(--hivis)">Política de Privacidade</a>. (LGPD)
              </span>
            </label>

            <button type="submit" class="btn btn--primary cart-checkout__cta">
              Finalizar e pagar
            </button>
            <p class="cart-checkout__pago-a" style="font-size:0.8rem;color:var(--d-muted);text-align:center;margin-top:0.8rem;">
              Pagamento via Mercado Pago (Pix ou cartão).
            </p>
          </form>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .cart-wrap { max-width: 1000px; }
  .cart-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: start; }
  @media (max-width: 760px) { .cart-grid { grid-template-columns: 1fr; } }
  .cart-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .cart-actions { margin-top: 1.2rem; display: grid; gap: 0.6rem; justify-items: start; }
  .cart-whats { font-size: 0.95rem; }
  .cart-whats__note { font-size: 0.82rem; color: var(--d-muted); margin: 0; }
  .cart-callback { display: grid; gap: 0.55rem; padding: 0.9rem 1rem; border: 1px dashed var(--d-line-strong); border-radius: 10px; max-width: 420px; }
  .cart-callback__title { font-size: 0.85rem; color: var(--d-text); margin: 0; }
  .cart-callback__row { display: flex; gap: 0.5rem; }
  .cart-callback__row input { flex: 1; min-width: 0; padding: 0.6rem 0.7rem; border: 1px solid var(--d-line-strong); border-radius: 6px; font: inherit; background: var(--ink-3); color: var(--d-text); }
  .cart-callback__consent { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.78rem; color: var(--d-muted); cursor: pointer; }
  .cart-callback__consent input { margin-top: 0.15rem; }
  .cart-callback__msg { font-size: 0.82rem; color: #86efac; margin: 0; min-height: 1.1em; }
  .cart-share { background: none; border: 1px solid var(--d-line-strong); color: var(--d-text); border-radius: 8px; padding: 0.6rem 0.9rem; cursor: pointer; font: inherit; font-size: 0.88rem; }
  .cart-share:hover { color: var(--hivis); border-color: var(--hivis); }
  .cart-share__msg { font-size: 0.82rem; color: var(--hivis); margin: 0.5rem 0 0; min-height: 1.1em; word-break: break-all; }
  .cart-checkout { border: 1px solid var(--d-line); border-radius: 12px; padding: 1.4rem; background: var(--ink-2); }
  .cart-checkout h2 { color: var(--d-text); }
  .radio-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0; cursor: pointer; color: var(--d-text); }
  .cart-coupon__row { display: flex; gap: 0.5rem; }
  .cart-coupon__row input { flex: 1; min-width: 0; padding: 0.6rem 0.7rem; border: 1px solid var(--d-line-strong); border-radius: 6px; font: inherit; background: var(--ink-3); color: var(--d-text); text-transform: uppercase; }
  .cart-coupon__apply { white-space: nowrap; }
  .cart-coupon__msg { font-size: 0.84rem; margin: 0.5rem 0 0; min-height: 1.1em; }
  .cart-coupon__msg[data-ok] { color: #86efac; }
  .cart-coupon__msg[data-err] { color: var(--hivis); }
  .cart-summary { margin: 1.4rem 0; padding-top: 1rem; border-top: 1px solid var(--d-line); display: grid; gap: 0.5rem; }
  .cart-summary__row { display: flex; justify-content: space-between; font-size: 0.95rem; color: var(--d-text); }
  .cart-cliche-nota { font-size: 0.82rem; color: var(--d-muted); line-height: 1.5; margin: 0 0 0.4rem; }
  .cart-cliche-nota strong { color: var(--d-text); }
  .cart-sum-desconto { color: #86efac; }
  .cart-sum-prazo-row { font-size: 0.85rem; color: var(--d-muted); }
  .cart-summary__total { font-size: 1.15rem; font-weight: 800; padding-top: 0.5rem; border-top: 1px dashed var(--d-line-strong); }
  .cart-checkout__cta { width: 100%; margin-top: 1rem; font-size: 1.05rem; padding-block: 0.85rem; }
  .cart-err, .cart-fail { background: color-mix(in srgb, var(--hivis) 16%, var(--ink-2)); color: var(--d-text); border: 1px solid var(--hivis); padding: 0.9rem 1.1rem; border-radius: 8px; margin-bottom: 1.5rem; }
  .cart-fail { display: grid; gap: 0.9rem; justify-items: start; }
  .cart-loading { color: var(--d-muted); padding: 2rem 0; }
  .cart-empty { text-align: center; padding: 3rem 1rem; display: grid; gap: 1.2rem; justify-items: center; }
</style>

<style is:global>
  /* Linhas montadas via innerHTML */
  .cart-line {
    display: grid; grid-template-columns: 1fr auto; gap: 0.45rem 1.2rem;
    padding: 1.15rem 1.25rem; border: 1px solid var(--d-line); border-radius: 12px;
    background: var(--ink-2); align-items: start;
  }
  .cart-line__name { font-weight: 700; color: var(--d-text); font-size: 1rem; line-height: 1.3; }
  .cart-line__meta { font-size: 0.82rem; color: var(--d-muted); }
  .cart-line__sub { text-align: right; font-weight: 800; white-space: nowrap; color: var(--d-text); font-size: 1.1rem; }
  .cart-line__edit { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; margin: 0.8rem 0 0.55rem; max-width: 300px; }
  .cart-line__edit label { display: grid; gap: 0.28rem; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--d-muted); font-weight: 600; }
  .cart-line__edit input {
    width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--d-line-strong);
    border-radius: 8px; font: inherit; font-size: 0.95rem; background: var(--ink-3); color: var(--d-text);
  }
  .cart-line__edit input:focus-visible { outline: 2px solid var(--hivis); outline-offset: 1px; border-color: var(--hivis); }
  .cart-line__rm { justify-self: start; background: none; border: 0; color: var(--d-muted); cursor: pointer; font-size: 0.82rem; text-decoration: underline; padding: 0; margin-top: 0.15rem; }
  .cart-line__rm:hover { color: var(--hivis); }
</style>

<script>
  import { resolveCart, setQuantidade, setM2, removeItem, getCart, encodeCart, decodeCart, restoreCart, formatPreco } from '../lib/cart';
  import { lojasById } from '../data/lojas';

  // Tabela local de frete (usada apenas se loja.frete === 'tabela-cep')
  const FAIXAS = [
    { min: 74000, max: 74894, valor: 150, prazo: '2–4 dias úteis', regiao: 'Goiânia' },
    { min: 74900, max: 74999, valor: 180, prazo: '3–5 dias úteis', regiao: 'Aparecida de Goiânia' },
    { min: 75250, max: 75269, valor: 200, prazo: '3–6 dias úteis', regiao: 'Senador Canedo' },
    { min: 75370, max: 75379, valor: 220, prazo: '4–7 dias úteis', regiao: 'Goianira' },
    { min: 75380, max: 75399, valor: 220, prazo: '4–7 dias úteis', regiao: 'Trindade' },
  ];

  const brl = formatPreco;
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;

  const main = $('main') as HTMLElement;
  const appUrl = main.dataset.appUrl || 'https://app.roilabs.com.br';
  const grid = $('.cart-grid') as HTMLElement;
  const empty = $('.cart-empty') as HTMLElement;
  const loading = $('.cart-loading') as HTMLElement;
  const fail = $('.cart-fail') as HTMLElement;
  const list = $('.cart-list') as HTMLUListElement;
  
  const cepWrap = $('.cart-cep') as HTMLElement;
  const cepInput = $('#ck-cep') as HTMLInputElement;
  const cepCalc = $('.cart-cep__calc') as HTMLButtonElement;
  const cepNote = $('.cart-cep__note') as HTMLElement;
  const entregaSection = $('.cart-entrega-section') as HTMLElement;
  const sumFreteRow = $('.cart-sum-frete-row') as HTMLElement;
  
  const sumProduto = $('.cart-sum-produto') as HTMLElement;
  const descRow = $('.cart-sum-desconto-row') as HTMLElement;
  const sumDesconto = $('.cart-sum-desconto') as HTMLElement;
  const sumFrete = $('.cart-sum-frete') as HTMLElement;
  const prazoRow = $('.cart-sum-prazo-row') as HTMLElement;
  const sumPrazo = $('.cart-sum-prazo') as HTMLElement;
  const sumTotal = $('.cart-sum-total') as HTMLElement;
  const form = $('#checkout-form') as HTMLFormElement;
  const errBox = $('.cart-err') as HTMLElement;
  const cupomField = form.elements.namedItem('cupom') as HTMLInputElement;
  
  const docReqLabel = $('.cart-doc-req') as HTMLElement;
  const docInput = $('#ck-doc') as HTMLInputElement;
  const pagoAText = $('.cart-checkout__pago-a') as HTMLElement;
  const cartTitle = $('.cart-title') as HTMLElement;
  const cartDesc = $('.cart-desc') as HTMLElement;
  const clicheNota = $('.cart-cliche-nota') as HTMLElement;

  // ── Share-link restore ────────────────────────────────────────────────────
  const cParam = new URLSearchParams(location.search).get('c');
  if (cParam) {
    const r = decodeCart(cParam);
    if (r === 'expired') {
      errBox.textContent = 'Este link de carrinho expirou (válido por 30 dias). Monte um novo carrinho.';
      errBox.hidden = false;
    } else {
      restoreCart(r);
    }
    history.replaceState(null, '', location.pathname);
  }

  // Erros de checkout
  const erro = new URLSearchParams(location.search).get('erro');
  const ERROS: Record<string, string> = {
    vazio: 'Seu carrinho está vazio ou os itens não estão mais disponíveis.',
    validacao: 'Confira nome, WhatsApp e o aceite da Política de Privacidade.',
    pagamento: 'Não foi possível abrir o pagamento. Tente novamente em instantes.',
    documento: 'Informe um CPF ou CNPJ válido — é obrigatório.',
    item_orcamento: 'Há um item que só é vendido sob orçamento.',
    minimo: 'Um dos itens está abaixo da quantidade mínima.',
    vertical_misto: 'Finalize pedidos de cadeiras diferentes separadamente.',
    sem_cobranca: 'Esta loja está configurada sem cobrança, entre em contato.',
    indisponivel: 'Esta loja não está disponível no momento.',
    cadeira_mista: 'O carrinho misturou itens de cadeiras diferentes (não suportado).',
  };
  if (erro && ERROS[erro]) { errBox.textContent = ERROS[erro]; errBox.hidden = false; }

  let cupom: { codigo: string; desconto: number } | null = null;
  const cupomInput = $('#ck-cupom') as HTMLInputElement;
  const cupomMsg = $('.cart-coupon__msg') as HTMLElement;

  let freteCotado: { valor: number; prazo: string; servico: string } | null = null;
  let freteChecado = false;

  function selectedEntrega() {
    return document.querySelector<HTMLInputElement>('input[name="entrega"]:checked')?.value || 'retirada';
  }

  async function atualizarFrete(loja: any) {
    if (loja.frete === 'nenhum') return;
    
    if (loja.frete === 'tabela-cep') {
      const cep = cepInput.value.replace(/\D/g, '');
      if (cep.length !== 8) {
        freteCotado = null;
        freteChecado = !!cep;
        return;
      }
      const prefix = parseInt(cep.slice(0, 5), 10);
      const f = FAIXAS.find((x) => prefix >= x.min && prefix <= x.max);
      if (f) {
        freteCotado = { valor: f.valor, prazo: f.prazo, servico: f.regiao };
      } else {
        freteCotado = null; // fora da tabela
      }
      freteChecado = true;
      renderTotals(loja);
      return;
    }

    if (loja.frete === 'cotacao') {
      const cartState = getCart();
      const cep = cepInput.value.replace(/\D/g, '');
      if (cep.length !== 8) { cepNote.textContent = 'Informe um CEP com 8 dígitos.'; return; }
      
      cepNote.textContent = 'Calculando frete…';
      freteCotado = null;
      try {
        const res = await fetch(`${appUrl}/api/frete/cotar`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          // cartState tem o formato v2 (cadeira + itens), que o backend lida
          body: new URLSearchParams({ cep, itens: JSON.stringify(cartState.itens), cadeira: loja.id }),
        });
        const data = await res.json();
        if (data.ok) {
          freteCotado = { valor: data.valor, prazo: data.prazo, servico: data.servico };
          cepNote.textContent = `${data.servico} · ${data.prazo}`;
        } else {
          cepNote.textContent = data.aviso || 'Frete a combinar após o pedido.';
        }
      } catch {
        cepNote.textContent = 'Não foi possível calcular o frete agora. A combinar.';
      }
      freteChecado = true;
      renderTotals(loja);
    }
  }

  function renderTotals(loja: any) {
    const { totalProduto } = resolveCart();
    sumProduto.textContent = brl(totalProduto);

    const desc = cupom ? Math.min(cupom.desconto, totalProduto) : 0;
    descRow.hidden = !cupom;
    if (cupom) sumDesconto.textContent = '−' + brl(desc);
    const base = Math.max(0, totalProduto - desc);

    if (loja.frete === 'nenhum' || !loja.unidadeConfig?.entregaFisica) {
      entregaSection.hidden = true;
      sumFreteRow.hidden = true;
      prazoRow.hidden = true;
      sumTotal.textContent = brl(base);
      return;
    }

    entregaSection.hidden = false;
    sumFreteRow.hidden = false;

    const entrega = selectedEntrega();
    if (entrega === 'retirada') {
      sumFrete.textContent = 'Grátis';
      prazoRow.hidden = true;
      sumTotal.textContent = brl(base);
      cepNote.textContent = '';
      return;
    }

    // entrega === 'entrega'
    if (freteCotado) {
      sumFrete.textContent = brl(freteCotado.valor);
      sumPrazo.textContent = freteCotado.prazo;
      prazoRow.hidden = false;
      sumTotal.textContent = brl(base + freteCotado.valor);
      if (loja.frete === 'tabela-cep') cepNote.textContent = freteCotado.servico ? `Região: ${freteCotado.servico}` : '';
    } else {
      sumFrete.textContent = freteChecado ? 'A combinar' : (loja.frete === 'cotacao' ? 'Calcule o frete' : 'Informe o CEP');
      prazoRow.hidden = true;
      sumTotal.textContent = freteChecado ? `${brl(base)} + frete` : brl(base);
      if (loja.frete === 'tabela-cep' && freteChecado) cepNote.textContent = 'CEP fora da tabela — frete a combinar com o fornecedor.';
    }
  }

  function render() {
    try {
      const res = resolveCart();
      const loja = lojasById.get(res.cadeira);
      if (!loja) throw new Error('Loja desconhecida');
      
      // Inject the static definition of Unidade so we know it
      loja.unidadeConfig = res.lines[0]?.unidade ?? { id: loja.unidade, entregaFisica: true }; // fallback if empty

      loading.hidden = true;
      fail.hidden = true;
      
      const hasItems = res.lines.length > 0;
      grid.hidden = !hasItems;
      empty.hidden = hasItems;
      if (!hasItems) return;

      // Header setup based on cadeira
      cartTitle.textContent = `Carrinho — ${loja.id === 'porcelanato' ? 'Porcelanato' : loja.id === 'fitas' ? 'Fitas' : loja.id}`;
      cartDesc.textContent = `Pagamento online seguro para ${loja.pagoA}.`;
      pagoAText.textContent = `Pagamento via Mercado Pago (Pix ou cartão) em nome de ${loja.pagoA}.`;
      
      // Doc
      if (loja.docObrigatorio) {
        docReqLabel.hidden = false;
        docInput.required = true;
      } else {
        docReqLabel.hidden = true;
        docInput.required = false;
      }

      // Frete config
      if (loja.frete === 'cotacao') {
        cepCalc.hidden = false; // exibe botão de calcular explícito
        cepInput.removeEventListener('input', onCepInputSync); // remove debounce/sync
      } else {
        cepCalc.hidden = true;
        cepInput.addEventListener('input', onCepInputSync);
      }

      // Clichê config (aviso global de linha fixa)
      clicheNota.hidden = !loja.linhaFixa || !res.lines.some((l) => l.slug === loja.linhaFixa?.quandoSlug);

      list.innerHTML = '';
      for (const l of res.lines) {
        const li = document.createElement('li');
        li.className = 'cart-line';
        
        let editHtml = '';
        let metaHtml = '';
        
        // M2 logic allows editing caixas OR m2. Outras unidades (rolo, assinatura) só editam quantidade (passo 1)
        if (l.unidade.id === 'm2') {
          editHtml = `
            <label>Caixas
              <input class="qty-cx" type="number" min="1" step="1" value="${l.quantidade}" data-slug="${l.slug}" />
            </label>
            <label>Metragem (m²)
              <input class="qty-m2" type="number" min="0.1" step="0.1" value="${(l.quantidade * (l.detalhe.m2PorCaixa as number || 1)).toFixed(2)}" data-slug="${l.slug}" />
            </label>
          `;
          metaHtml = `
            <div class="cart-line__meta">${formatPreco(l.precoUnitario)}/m² · ${l.detalhe.m2PorCaixa} m²/caixa</div>
            <div class="cart-line__meta" style="grid-column: 1 / -1">${l.quantidade} caixa(s) cobrem ${(l.quantidade * (l.detalhe.m2PorCaixa as number || 1)).toFixed(2).replace('.', ',')} m²</div>
          `;
        } else {
          // rolo ou assinatura
          const isFita = l.unidade.id === 'rolo';
          const faixaMeta = isFita && l.detalhe.faixaMin ? `(faixa ${l.detalhe.faixaMin}${l.detalhe.faixaMax === null ? '+' : `–${l.detalhe.faixaMax}`})` : '';
          editHtml = `
            <label>${l.unidade.rotuloPlural}
              <input class="qty-cx" type="number" min="1" step="1" value="${l.quantidade}" data-slug="${l.slug}" />
            </label>
          `;
          metaHtml = `
            <div class="cart-line__meta">${formatPreco(l.precoUnitario)}/${l.unidade.rotulo} ${faixaMeta}</div>
          `;
        }

        li.innerHTML = `
          <div>
            <div class="cart-line__name">${l.nome}</div>
            ${metaHtml}
            <div class="cart-line__edit">
              ${editHtml}
            </div>
            <button type="button" class="cart-line__rm" data-rm="${l.slug}">Remover</button>
          </div>
          <div class="cart-line__sub">${l.subtotalFmt}</div>`;
        list.appendChild(li);
      }
      
      // Update form action logic if modoCobranca é parceiro (handled in server, but good to know)
      // The server will do the redirect to parceiro if it receives modoCobranca=parceiro
      renderTotals(loja);
    } catch (e) {
      console.error('cart render failed', e);
      loading.hidden = true;
      grid.hidden = true;
      empty.hidden = true;
      fail.hidden = false;
    }
  }

  const onCepInputSync = () => {
    const res = resolveCart();
    const loja = lojasById.get(res.cadeira);
    if (loja) atualizarFrete(loja);
  };

  async function applyCupom(codigo: string, silent = false) {
    const resCart = resolveCart();
    if (resCart.lines.length === 0) { cupom = null; cupomField.value = ''; cupomMsg.textContent=''; renderTotals(lojasById.get(resCart.cadeira)); return; }
    if (!silent) { cupomMsg.textContent = 'Validando…'; cupomMsg.removeAttribute('data-ok'); cupomMsg.removeAttribute('data-err'); }
    try {
      const res = await fetch(`${appUrl}/api/cupom/validar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ codigo, cadeira: resCart.cadeira, itens: JSON.stringify(getCart().itens) }),
      });
      const data = await res.json();
      if (data.ok) {
        cupom = { codigo: data.codigo, desconto: data.desconto };
        cupomField.value = data.codigo;
        cupomMsg.textContent = `Cupom ${data.codigo} aplicado: −${formatPreco(data.desconto)}`;
        cupomMsg.setAttribute('data-ok', '');
        cupomMsg.removeAttribute('data-err');
      } else {
        cupom = null;
        cupomField.value = '';
        cupomMsg.textContent = data.motivo || 'Cupom inválido.';
        cupomMsg.setAttribute('data-err', '');
        cupomMsg.removeAttribute('data-ok');
      }
    } catch {
      if (!silent) { cupomMsg.textContent = 'Não foi possível validar agora.'; cupomMsg.setAttribute('data-err', ''); cupomMsg.removeAttribute('data-ok'); }
    }
    renderTotals(lojasById.get(resCart.cadeira));
  }

  list.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.dataset.slug) return;
    if (t.classList.contains('qty-cx')) setQuantidade(t.dataset.slug, parseInt(t.value, 10) || 1);
    else if (t.classList.contains('qty-m2')) setM2(t.dataset.slug, parseFloat(t.value.replace(',', '.')) || 0);
    render();
    if (cupom) applyCupom(cupom.codigo, true);
  });

  list.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.dataset.rm) { removeItem(t.dataset.rm); render(); if(cupom) applyCupom(cupom.codigo, true); }
  });

  form.querySelectorAll('input[name="entrega"]').forEach((r) =>
    r.addEventListener('change', () => { 
      cepWrap.hidden = selectedEntrega() !== 'entrega'; 
      const res = resolveCart();
      const loja = lojasById.get(res.cadeira);
      if (loja) renderTotals(loja); 
    }),
  );

  cepCalc.addEventListener('click', () => {
    const res = resolveCart();
    const loja = lojasById.get(res.cadeira);
    if (loja) atualizarFrete(loja);
  });

  $('.cart-coupon__apply').addEventListener('click', () => {
    const codigo = cupomInput.value.trim();
    if (codigo) applyCupom(codigo);
  });

  function postOrcamentoLead(nome: string, whatsapp: string) {
    const { cadeira, lines, totalProduto } = resolveCart();
    fetch(`${appUrl}/api/leads-consumidor`, {
      method: 'POST',
      body: new URLSearchParams({
        nome, whatsapp, consent: '1',
        produto: `Orçamento carrinho ${cadeira} (${lines.length} item(ns) · ${formatPreco(totalProduto)})`,
        pagina: '/carrinho',
        mensagem: `Pediu orçamento pelo WhatsApp. Carrinho: ${location.origin}/carrinho/?c=${encodeCart()}`,
        origem: localStorage.getItem('rlft') ?? '',
      }),
      keepalive: true,
    }).catch(() => {});
  }

  const cbForm = $('.cart-callback') as HTMLFormElement;
  const cbInput = $('.cart-callback__row input') as HTMLInputElement;
  const cbMsg = $('.cart-callback__msg') as HTMLElement;

  $('.cart-whats').addEventListener('click', () => {
    const btn = $('.cart-whats') as HTMLButtonElement;
    const msg = $('.cart-share__msg') as HTMLElement;
    const res = resolveCart();
    if (res.lines.length === 0) { msg.textContent = 'Adicione itens antes de pedir o orçamento.'; return; }
    const cartUrl = `${location.origin}/carrinho/?c=${encodeCart()}`;
    const texto = `Olá! Quero um orçamento deste carrinho de ${res.cadeira}:\n${cartUrl}`;
    
    const nomeVal = (form.elements.namedItem('nome') as HTMLInputElement).value.trim();
    const whatsVal = (form.elements.namedItem('whatsapp') as HTMLInputElement).value.trim();
    const consentOk = (form.elements.namedItem('consent') as HTMLInputElement).checked;
    if (whatsVal && consentOk) postOrcamentoLead(nomeVal || 'Orçamento WhatsApp', whatsVal);
    else if (!cbMsg.textContent) cbForm.hidden = false;
    
    window.open(`https://wa.me/${btn.dataset.whats}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
  });

  cbForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!cbForm.checkValidity()) { cbForm.reportValidity(); return; }
    postOrcamentoLead('Orçamento WhatsApp (carrinho)', cbInput.value.trim());
    cbMsg.textContent = 'Recebido! Nosso especialista te chama em até 24h úteis.';
    (cbForm.querySelector('.cart-callback__row') as HTMLElement).hidden = true;
    (cbForm.querySelector('.cart-callback__consent') as HTMLElement).hidden = true;
  });

  $('.cart-orc').addEventListener('click', () => {
    const msg = $('.cart-share__msg') as HTMLElement;
    if (resolveCart().lines.length === 0) { msg.textContent = 'Adicione itens antes de gerar o orçamento.'; return; }
    window.open(`/orcamento?c=${encodeCart()}`, '_blank', 'noopener');
  });

  $('.cart-share').addEventListener('click', async () => {
    const msg = $('.cart-share__msg') as HTMLElement;
    if (resolveCart().lines.length === 0) { msg.textContent = 'Adicione itens antes de gerar o link.'; return; }
    const url = `${location.origin}/carrinho/?c=${encodeCart()}`;
    try {
      await navigator.clipboard.writeText(url);
      msg.textContent = 'Link copiado! Cole onde quiser — válido por 30 dias.';
    } catch {
      msg.textContent = url;
    }
  });

  (fail.querySelector('.cart-fail__retry') as HTMLButtonElement).addEventListener('click', render);

  form.addEventListener('submit', (e) => {
    const state = getCart();
    if (state.itens.length === 0) { e.preventDefault(); render(); return; }
    if (!form.checkValidity()) { e.preventDefault(); form.reportValidity(); return; }
    (form.elements.namedItem('itens') as HTMLInputElement).value = JSON.stringify(state.itens);
    (form.elements.namedItem('cadeira') as HTMLInputElement).value = state.cadeira;
    (form.elements.namedItem('vertical') as HTMLInputElement).value = state.cadeira; // legacy fallback
    (form.elements.namedItem('origin') as HTMLInputElement).value = location.origin;
  });

  window.addEventListener('roi-cart-change', render);

  render();
</script>
