---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const apply = 'mailto:parceria@roilabs.com.br?subject=Candidatura%20%C3%A0%20cadeira%20%E2%80%94%20Goi%C3%A2nia';

// Canal direto B2B (Gate 3): fornecedor high-ticket quer conversa, não formulário.
const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? '5562993265713';
const whatsHref = `https://wa.me/${whatsapp}?text=${encodeURIComponent(
  'Quero saber mais sobre a cadeira de revestimentos em Goiânia'
)}`;

// Candidaturas vão para o app admin (app.roilabs.com.br), que grava no DB.
// POST urlencoded simples (sem preflight CORS); a API redireciona pro `redirect`.
const CANDIDATURAS_ENDPOINT = 'https://app.roilabs.com.br/api/candidaturas';

// Mapa de cadeiras — skeleton ESTÁTICO (SEO + no-JS). A verdade vem do DB AO VIVO:
// o <script is:inline> no fim desta section busca /api/cadeiras no NAVEGADOR e atualiza
// status/aberta a cada carregamento. Build-time fetch foi removido de propósito: o Docker
// cacheia o layer do `npm run build`, então redeploy sem commit novo servia dist velho e
// não refletia o admin. Runtime fetch é imune a esse cache e reflete a edição na hora.
// taken/href são presentational (cadeira já ocupada + link pra venture); só o estático os usa,
// o fetch ao vivo não os toca (casa por índice e a 7ª não existe no DB até rodar o seed).
const seats: { niche: string; status: string; open: boolean; taken?: boolean; href?: string }[] = [
  { niche: 'Revestimentos / Porcelanato', status: 'Curadoria aberta', open: true },
  { niche: 'Materiais de construção', status: 'Em estudo', open: false },
  { niche: 'Esquadrias / Vidraçaria', status: 'Em estudo', open: false },
  { niche: 'Iluminação / Elétrica', status: 'Em estudo', open: false },
  { niche: 'Marcenaria sob medida', status: 'Em estudo', open: false },
  { niche: 'Pisos / Deck externo', status: 'Em estudo', open: false },
  { niche: 'Fitas adesivas', status: 'Ocupada · Tapepro', open: false, taken: true, href: 'https://tapepro.roilabs.com.br/' },
];

// Nó próprio da home no @graph: o serviço Growth Partner (Base entrega Organization + WebSite).
const jsonLdNodes = [
  {
    '@type': 'Service',
    '@id': 'https://roilabs.com.br/#service',
    name: 'Growth Partner — operação de vendas online pago pelo sucesso',
    serviceType: 'Operação de vendas online (SEO programático de alta intenção)',
    description:
      'A ROI Labs constrói e opera a venda online de um fornecedor regional por nicho: páginas de alta intenção validadas por volume real de busca, sem mensalidade e sem custo fixo. Remuneração 100% variável, paga somente quando a venda acontece. Exclusividade de cadeira: uma empresa por nicho, por polo.',
    provider: { '@id': 'https://roilabs.com.br/#org' },
    areaServed: { '@type': 'City', name: 'Goiânia' },
    offers: {
      '@type': 'Offer',
      description:
        'Sem mensalidade: fração variável sobre a venda concretizada, com SLA de estoque e despacho.',
    },
  },
];
---

<Base jsonLdNodes={jsonLdNodes}>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__inner">
        <div>
          <span class="eyebrow hero__eyebrow">Growth Partner · Polo Goiânia</span>
          <h1 id="hero-title">
            Construímos sua venda&nbsp;online.<br />
            Você paga <span class="accent">quando vende.</span>
          </h1>
          <p class="hero__sub">
            A ROI Labs banca a tecnologia e o tráfego. Você entra com o produto.
            A conta só chega depois da venda — porque o nosso lucro é uma fração
            do seu.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#candidatar">Aplicar para a cadeira</a>
            <a class="btn btn--whats" href={whatsHref} target="_blank" rel="noopener">Chamar no WhatsApp</a>
            <a class="btn btn--ghost" href="#mecanica">Ver como funciona</a>
          </div>
        </div>

        <aside class="chair" aria-label="Status da cadeira de Goiânia">
          <div class="chair__top">
            <span class="chair__label">Cadeira</span>
            <span class="chair__num">Nº 01</span>
          </div>
          <div class="chair__row">
            <span class="chair__k">Polo</span>
            <span class="chair__v">Goiânia</span>
          </div>
          <div class="chair__row">
            <span class="chair__k">Nicho</span>
            <span class="chair__v">Revestimentos&nbsp;/&nbsp;Porcelanato</span>
          </div>
          <div class="chair__row">
            <span class="chair__k">Status</span>
            <span class="chair__v chair__v--hi">
              <span class="status-dot" aria-hidden="true"></span>Curadoria aberta
            </span>
          </div>
          <div class="chair__row">
            <span class="chair__k">Custo fixo</span>
            <span class="chair__v">R$ 0</span>
          </div>
          <div class="chair__row">
            <span class="chair__k">Exclusividade</span>
            <span class="chair__v">1 por nicho / polo</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- MANIFESTO -->
    <section class="section section--dark manifesto" aria-labelledby="manifesto-title">
      <div class="wrap manifesto__grid">
        <p class="manifesto__big" id="manifesto-title">
          Não somos agência.<br />
          Somos <em>sócios de performance</em> da sua operação digital.
        </p>
        <p class="manifesto__note">
          A ROI Labs é uma fábrica de infraestrutura de vendas. Construímos o
          ecossistema — site, SEO de alta intenção, captação — que coloca
          fornecedores regionais de alto padrão na frente de quem já está pronto
          pra comprar. Sem fee mensal, sem projeto fechado, sem risco pra você.
        </p>
      </div>
    </section>

    <!-- MECÂNICA -->
    <section class="section section--light" id="mecanica" aria-labelledby="mecanica-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">A mecânica · três fases</span>
          <h2 id="mecanica-title">Risco nosso na largada. Lucro dividido na chegada.</h2>
        </div>

        <div class="steps">
          <article class="step">
            <span class="step__num">01 — Curadoria</span>
            <h3>Uma empresa por nicho</h3>
            <p>
              Selecionamos um único fornecedor A-Player por setor: produto
              excelente, presença online fraca. Você passa nos três gates de
              validação — ou a cadeira não abre.
            </p>
            <span class="step__tag">Gate de entrada</span>
          </article>

          <article class="step">
            <span class="step__num">02 — Construção</span>
            <h3>Máquina de tráfego orgânico</h3>
            <p>
              Montamos centenas de páginas de alta intenção — uma para cada
              combinação de produto, característica e bairro com busca real.
              Custo de tecnologia e tráfego é nosso.
            </p>
            <span class="step__tag">Custo da ROI Labs</span>
          </article>

          <article class="step">
            <span class="step__num">03 — Performance</span>
            <h3>Só ganhamos se você ganha</h3>
            <p>
              Quando as vendas chegam, dividimos. Nossa parte é variável e
              atrelada a SLA de estoque e despacho. Sua cadeira é exclusiva por
              um ano, renovável por entrega.
            </p>
            <span class="step__tag">100% variável</span>
          </article>
        </div>
      </div>
    </section>

    <!-- MAPA DE CADEIRAS (signature) -->
    <section class="section section--light" id="cadeiras" aria-labelledby="cadeiras-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">Escassez programada</span>
          <h2 id="cadeiras-title">Mapa de cadeiras — Goiânia</h2>
          <p class="section__lead">
            Uma cadeira por nicho, por polo, renovável por desempenho. Quando uma
            fecha, ela sai do mapa — e o seu concorrente não senta nela.
          </p>
        </div>

        <ul class="map__grid" role="list">
          {seats.map((s) => (
            <li class={`seat ${s.open ? 'seat--open' : ''} ${s.taken ? 'seat--taken' : ''}`}>
              {s.href ? (
                <a class="seat__niche" href={s.href} target="_blank" rel="noopener">{s.niche} ↗</a>
              ) : (
                <span class="seat__niche">{s.niche}</span>
              )}
              <span class="seat__status">
                <span class={`seat__ring`} aria-hidden="true"></span>
                {s.status}
              </span>
            </li>
          ))}
        </ul>
        <p class="map__caption">
          // polo 01 de N · novos nichos abrem após a primeira cadeira faturar
        </p>
      </div>
    </section>

    <script is:inline>
      // Mapa de cadeiras AO VIVO: busca o DB no navegador e sobrescreve o skeleton estático.
      // ponytail: casa por índice — 6 nichos fixos, a API ordena por `ordem`. Se um dia a
      // contagem divergir, casar por id. Falhou o fetch? mantém o skeleton (degrada limpo).
      fetch('https://app.roilabs.com.br/api/cadeiras')
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((seats) => {
          document.querySelectorAll('.map__grid .seat').forEach((li, i) => {
            const s = seats[i];
            if (!s) return;
            li.classList.toggle('seat--open', !!s.open);
            const st = li.querySelector('.seat__status');
            if (!st) return;
            st.textContent = '';
            const ring = document.createElement('span');
            ring.className = 'seat__ring';
            ring.setAttribute('aria-hidden', 'true');
            st.appendChild(ring);
            st.appendChild(document.createTextNode(' ' + s.status));
          });
        })
        .catch(() => {});
    </script>

    <!-- PROVA / MERCADO -->
    <section class="section section--dark" id="mercado" aria-labelledby="mercado-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">Leitura de mercado · Goiânia</span>
          <h2 id="mercado-title">A demanda já existe. Falta quem a capture.</h2>
          <p class="section__lead">
            Não é aposta. O volume de busca local foi medido antes de abrir a
            cadeira — e a concorrência orgânica é fraca.
          </p>
        </div>

        <div class="readout" role="group" aria-label="Indicadores de demanda em Goiânia">
          <div class="readout__bar">
            <span class="readout__dotrow" aria-hidden="true"><span></span><span></span><span></span></span>
            keyword_planner — goiânia — 2026
          </div>
          <div class="readout__body">
            <div class="metric">
              <div class="metric__val">1.900<span class="unit">/mês</span></div>
              <div class="metric__key">buscas por "porcelanato" só em Goiânia</div>
            </div>
            <div class="metric">
              <div class="metric__val">R$ 0<span class="unit">mídia</span></div>
              <div class="metric__key">captação 100% orgânica, não compramos clique</div>
            </div>
            <div class="metric">
              <div class="metric__val">01<span class="unit">cadeira</span></div>
              <div class="metric__key">por nicho, por polo — o resto fica de fora</div>
            </div>
          </div>
        </div>
        <p class="prova__foot">
          Fonte: Google Ads Keyword Planner, cidade de Goiânia, 2026. Demanda
          validada antes do investimento.
        </p>

        <!-- Prova viva: a máquina do polo 1 é pública — deixar o fornecedor VER
             o que recebe vale mais que qualquer promessa. -->
        <div class="prova-viva">
          <p>
            <strong>Não é maquete.</strong> A máquina do polo 1 já está no ar — catálogo,
            80+ páginas de alta intenção, calculadora e checkout funcionando:
          </p>
          <a class="btn btn--ghost" href="https://goiania.roilabs.com.br/" target="_blank" rel="noopener">
            Ver a operação de porcelanato no ar →
          </a>
        </div>
      </div>
    </section>

    <!-- ICP: OS 3 GATES -->
    <section class="section section--light" id="cadeira-pra-voce" aria-labelledby="icp-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">A cadeira é sua se…</span>
          <h2 id="icp-title">Dois gates já bateram. Falta o terceiro: você.</h2>
          <p class="section__lead">
            Não abrimos uma cadeira no escuro. A de revestimentos de Goiânia só
            existe porque passou na validação — e a última peça que falta é o
            fornecedor certo.
          </p>
        </div>

        <div class="gate-list" role="list" aria-label="Os três gates da cadeira">
          <div class="gate gate--done" role="listitem">
            <span class="gate__check" aria-hidden="true">✓</span>
            <div class="gate__body">
              <div class="gate__name">Gate 01 — Demanda comprovada</div>
              <div class="gate__desc">1.900 buscas/mês por "porcelanato" só em Goiânia.</div>
            </div>
            <span class="gate__state">Validado</span>
          </div>
          <div class="gate gate--done" role="listitem">
            <span class="gate__check" aria-hidden="true">✓</span>
            <div class="gate__body">
              <div class="gate__name">Gate 02 — Brecha na busca</div>
              <div class="gate__desc">SERP local fraca: só marketplace genérico ranqueia. Espaço pra dominar.</div>
            </div>
            <span class="gate__state">Validado</span>
          </div>
          <div class="gate gate--open" role="listitem">
            <span class="gate__check" aria-hidden="true"></span>
            <div class="gate__body">
              <div class="gate__name">Gate 03 — Fornecedor A-Player</div>
              <div class="gate__desc">O produto e a logística que a demanda exige. Esse é você.</div>
            </div>
            <span class="gate__state">Aberto</span>
          </div>
        </div>

        <div class="fit">
          <div class="fit__col fit__col--yes">
            <div class="fit__title">É pra você se</div>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✓</span> Tem catálogo próprio e amplo de revestimentos / porcelanato.</p>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✓</span> Aguenta estoque e despacho rápido — pronta-entrega de verdade.</p>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✓</span> Produto forte, presença online fraca, e quer escalar.</p>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✓</span> Topa exclusividade de cadeira atrelada a SLA.</p>
          </div>
          <div class="fit__col fit__col--no">
            <div class="fit__title">Não é pra você se</div>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✕</span> Revende sem catálogo ou marca próprios.</p>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✕</span> Não consegue acompanhar um salto de demanda.</p>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✕</span> Procura agência de mídia paga com fee mensal.</p>
            <p class="fit__item"><span class="fit__mark" aria-hidden="true">✕</span> Não quer compromisso de exclusividade.</p>
          </div>
        </div>

        <div class="close__whats" style="margin-top: 2.5rem; text-align: center;">
          <a class="btn btn--ghost btn--on-light" href="/simulador/">Quanto sobra pra você? Simule sua receita →</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--dark" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">Antes de candidatar</span>
          <h2 id="faq-title">As perguntas que todo fornecedor faz.</h2>
        </div>

        <div class="faq">
          <details class="faq__item">
            <summary>Quanto a ROI Labs fica?</summary>
            <p class="faq__a">
              Uma fração variável do que você vende, definida em contrato. Sem
              mensalidade, sem setup, sem piso. Se não vendeu, não cobramos — o
              nosso lucro é uma parte do seu.
            </p>
          </details>
          <details class="faq__item">
            <summary>E se eu já tenho site?</summary>
            <p class="faq__a">
              Melhor ainda. Não pedimos pra trocar nada: construímos por cima a
              camada de captação de alta intenção — as centenas de páginas de
              cauda longa — que o seu site institucional não cobre.
            </p>
          </details>
          <details class="faq__item">
            <summary>A exclusividade me prende em quê?</summary>
            <p class="faq__a">
              Você fica como o único fornecedor do seu nicho no polo por um ano,
              renovável. Em troca, mantém o SLA de estoque e despacho. Não
              cumprimos a nossa parte? Você sai — a cadeira é sua enquanto a
              gente entrega resultado.
            </p>
          </details>
          <details class="faq__item">
            <summary>Preciso de quanto estoque?</summary>
            <p class="faq__a">
              Não é volume gigante — é consistência. Capacidade de atender o
              aumento de pedidos que o tráfego traz, com pronta-entrega. É o que
              separa um A-Player na curadoria.
            </p>
          </details>
          <details class="faq__item">
            <summary>E se não der resultado?</summary>
            <p class="faq__a">
              O risco de tecnologia e tráfego é todo nosso. Você não desembolsa
              nada pra começar e não paga nada se não vender. O alinhamento é
              total: só crescemos juntos.
            </p>
          </details>
          <details class="faq__item">
            <summary>Quanto tempo até as vendas?</summary>
            <p class="faq__a">
              SEO orgânico maduro leva de 3 a 6 meses — a travessia do deserto.
              Por isso a exclusividade e a transparência: você sabe exatamente em
              que fase está, sem promessa de resultado da noite pro dia.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CANDIDATAR (close + form) -->
    <section class="section close" id="candidatar" aria-labelledby="close-title">
      <div class="wrap close__inner">
        <div>
          <span class="eyebrow close__eyebrow">Candidate-se</span>
          <h2 id="close-title">A cadeira de revestimentos de Goiânia está em curadoria.</h2>
          <p class="close__copy">
            Uma empresa vai sentar nela e dominar a busca local de porcelanato.
            Sem custo fixo, sem risco de tecnologia. Candidate-se antes do seu
            concorrente.
          </p>
          <p class="close__whats">
            <a class="btn btn--whats" href={whatsHref} target="_blank" rel="noopener">Chamar no WhatsApp agora</a>
          </p>
          <p class="close__fine">
            Prefere formulário? Resposta em até 48h úteis. Ou e-mail:
            <a href={apply}>parceria@roilabs.com.br</a>
          </p>
        </div>

        <div class="form-card">
          <form class="form" action={CANDIDATURAS_ENDPOINT} method="POST">
            <input type="hidden" name="redirect" value="https://roilabs.com.br/obrigado/" />
            <input type="hidden" name="origem" />

            <div class="form__hp" aria-hidden="true">
              <label>Não preencha<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="form__row">
              <div class="field field--req">
                <label for="f-nome">Seu nome</label>
                <input id="f-nome" name="nome" type="text" required autocomplete="name" />
              </div>
              <div class="field field--req">
                <label for="f-empresa">Empresa</label>
                <input id="f-empresa" name="empresa" type="text" required autocomplete="organization" />
              </div>
            </div>

            <div class="form__row">
              <div class="field field--req">
                <label for="f-whats">WhatsApp</label>
                <input id="f-whats" name="whatsapp" type="tel" required placeholder="(62) 9____-____" autocomplete="tel" />
              </div>
              <div class="field">
                <label for="f-cidade">Cidade</label>
                <input id="f-cidade" name="cidade" type="text" value="Goiânia" autocomplete="address-level2" />
              </div>
            </div>

            <div class="field">
              <label for="f-cat">Categoria / nicho</label>
              <select id="f-cat" name="categoria">
                <option>Revestimentos / Porcelanato</option>
                <option>Materiais de construção</option>
                <option>Esquadrias / Vidraçaria</option>
                <option>Iluminação / Elétrica</option>
                <option>Marcenaria sob medida</option>
                <option>Pisos / Deck externo</option>
                <option>Outro</option>
              </select>
            </div>

            <div class="field">
              <label for="f-site">Site atual (opcional)</label>
              <input id="f-site" name="site" type="url" placeholder="https://" />
            </div>

            <div class="field">
              <label for="f-msg">Sobre sua operação (opcional)</label>
              <textarea id="f-msg" name="mensagem" placeholder="Catálogo, capacidade de estoque/despacho, o que já vende online…"></textarea>
            </div>

            <button class="btn btn--primary form__submit" type="submit">Enviar candidatura</button>
            <p class="form__note">Sem custo, sem compromisso. Leva 1 minuto.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
