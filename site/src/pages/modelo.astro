    <script>
      // A barra da conta e a trilha das etapas acendem quando entram na tela, uma vez. Sem JS ou com
      // "reduzir movimento", este script não segura nada: tudo já aparece aceso.
      const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alvos = [...document.querySelectorAll<HTMLElement>('[data-acende], [data-trilha]')];
      if (!calmo && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) =>
            entradas.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.setAttribute('data-aceso', '');
              io.unobserve(e.target);
            }),
          { threshold: 0.2 }
        );
        alvos.forEach((el) => {
          el.setAttribute('data-espera', '');
          io.observe(el);
        });
      }
    </script>

