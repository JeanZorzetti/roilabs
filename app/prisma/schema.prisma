// ROI Labs admin — Postgres (EasyPanel). snake_case tables via @@map (owner convention).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Candidaturas = leads do form do site. status: novo | curadoria | aprovado | recusado
model Candidatura {
  id        String   @id @default(cuid())
  nome      String
  empresa   String
  whatsapp  String
  cidade    String?
  categoria String?
  site      String?
  mensagem  String?
  status    String   @default("novo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parceiros Parceiro[]

  @@index([status])
  @@map("candidaturas")
}

// Lead de consumidor vindo do formulário das páginas pSEO de porcelanato.
model LeadConsumidor {
  id          String   @id @default(cuid())
  nome        String
  whatsapp    String
  produto     String?
  pagina      String?
  mensagem    String?
  consentLGPD Boolean  @default(false) @map("consent_lgpd")
  status      String   @default("novo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("leads_consumidor")
}

// Pedido de e-commerce de porcelanato (site Goiânia). pago = reserva até o fornecedor confirmar.
model Pedido {
  id                String   @id @default(cuid())
  nome              String
  whatsapp          String
  email             String?
  entrega           String // retirada | entrega | a_combinar
  compradorDoc      String?  @map("comprador_doc") // CPF/CNPJ normalizado (só dígitos); opcional no B2C (010)
  cep               String?
  frete             Decimal? @db.Decimal(10, 2) // null = a combinar (FR-016)
  cupomCodigo       String?  @map("cupom_codigo") // snapshot do cupom aplicado; null se sem cupom
  desconto          Decimal? @db.Decimal(10, 2) // desconto recalculado no servidor (só sobre produto)
  total             Decimal  @db.Decimal(10, 2) // produto − desconto + frete (recalculado no servidor)
  statusPagamento   String   @default("pendente") @map("status_pagamento") // pendente | pago | reembolsado
  statusFulfillment String   @default("aguardando") @map("status_fulfillment") // aguardando | confirmado | reembolsado
  mpPreferenceId    String?  @map("mp_preference_id")
  mpPaymentId       String?  @unique @map("mp_payment_id") // chave de idempotência do webhook (D4)
  consent           Boolean  @default(false)

  // 011: qual vertical o pedido é — decide qual relação de itens ler e qual modelo de frete
  // se aplica. Um pedido tem itens de UM só vertical (FR-028). Backfill explícito em
  // scripts/migrate-011-backfill.mjs: o @default não reescreve linha já gravada.
  vertical    String  @default("porcelanato") // 'porcelanato' | 'fitas'
  // Por que o frete ficou "a combinar": 'cep_nao_atendido' (operação normal) vs
  // 'falha_tecnica' (incidente, dispara alerta). Anulável DE PROPÓSITO — NOT NULL aqui
  // quebraria `where: { freteMotivo: null }` (mesma landmine da 010).
  freteMotivo String? @map("frete_motivo")

  itens     ItemPedido[]
  itensFita ItemPedidoFita[]
  negocios  NegocioOriginado[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([statusPagamento])
  @@map("pedidos")
}

model ItemPedido {
  id       String  @id @default(cuid())
  pedidoId String  @map("pedido_id")
  slug     String
  caixas   Int?
  m2       Decimal? @db.Decimal(10, 2)
  precoM2  Decimal? @db.Decimal(10, 2) @map("preco_m2") // snapshot do preço/m² na compra — legado, NULL em pedidos pós-013; conferência cruzada até T027
  subtotal Decimal @db.Decimal(10, 2)

  // 013: colunas do item unificado. ANULÁVEIS de propósito — @default NÃO reescreve linha
  // já gravada (landmine registrada 2× neste repo). Preenchidas por UPDATE explícito no
  // scripts/migrate-013-backfill.mjs. Removidas na fase 5 (colunas legadas acima servem
  // de conferência cruzada até lá).
  unidade           String?                                      // m2 | rolo | assinatura
  quantidade        Decimal? @db.Decimal(10, 3)                  // 3 casas: m² fracionário existe
  precoUnitario     Decimal? @db.Decimal(10, 2) @map("preco_unitario") // unitário aplicado
  detalhe           Json?                                        // justificativa do preço (FR-004)
  recorrencia       String?                                      // mensal | anual; null = avulso
  assinaturaRef     String?  @map("assinatura_ref")              // id da assinatura no gateway
  assinaturaEstado  String?  @map("assinatura_estado")           // ativa | inadimplente | cancelada

  // Snapshot congelado quando o pedido vira 'pago' (US4). NULL = pedido anterior à feature.
  pisoSnapshot              Decimal? @db.Decimal(10, 2) @map("piso_snapshot")
  modalidadeSnapshot        String?  @map("modalidade_snapshot") // 'wl'|'intermediacao'
  comissaoSnapshot          Decimal? @db.Decimal(6, 4) @map("comissao_snapshot")
  aliqIntermediacaoSnapshot Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao_snapshot")
  aliqWLSnapshot            Decimal? @db.Decimal(6, 4) @map("aliq_wl_snapshot")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido")
}

// 015: estoque por SKU de variação. Catálogo continua em arquivo (013); ESTADO mora aqui,
// porque arquivo não debita. A chave é (cadeira, sku) — nunca o rótulo tamanho/cor.
model EstoqueVariacao {
  id         String   @id @default(cuid())
  cadeira    String // 'mana' — mesmo espaço de nome de Pedido.vertical
  sku        String // = ItemPedido.slug quando a unidade é 'peca'
  quantidade Int      @default(0) // NUNCA negativo: a guarda é o WHERE do débito condicional
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([cadeira, sku])
  @@map("estoque_variacao")
}

// Item de pedido de FITA (011). Tabela legada — a 013 unifica em ItemPedido; esta tabela
// e a relação acima só existem até o backfill copiar os dados e T026 remover ambos.
model ItemPedidoFita {
  id        String  @id @default(cuid())
  pedidoId  String  @map("pedido_id")
  slug      String
  rolos     Int
  precoRolo Decimal @db.Decimal(10, 2) @map("preco_rolo") // snapshot do unitário da faixa aplicada
  faixaMin  Int     @map("faixa_min") // faixa aplicada — sem isto um pedido antigo não permite
  faixaMax  Int?    @map("faixa_max") // reconstruir POR QUE cobrou aquele unitário
  subtotal  Decimal @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido_fita")
}


// Parâmetros dos centros de custo (global + linha). Campos nullable = herda a camada acima.
model ParametroCentroCusto {
  id                String   @id @default(cuid())
  escopo            String // 'global' | 'linha'
  chave             String? // null no global; nome da linha quando escopo='linha'
  markup            Decimal? @db.Decimal(6, 4)
  comissao          Decimal? @db.Decimal(6, 4)
  aliqIntermediacao Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao")
  aliqWL            Decimal? @db.Decimal(6, 4) @map("aliq_wl")
  cenario           String? // só no global: 'conservador'|'base'|'otimista'|'ajustado'
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([escopo, chave])
  @@map("parametro_centro_custo")
}

// Config por SKU: piso real, modalidade-alvo, overrides de parâmetro. Tudo opcional.
model SkuConfig {
  id                String   @id @default(cuid())
  slug              String   @unique
  linha             String? // nome de uma ParametroCentroCusto escopo=linha
  piso              Decimal? @db.Decimal(10, 2) // atacado real /m²; ausente = estimado por markup
  modalidadeAlvo    String?  @map("modalidade_alvo") // 'wl'|'intermediacao'; ausente = Intermediação
  markup            Decimal? @db.Decimal(6, 4)
  comissao          Decimal? @db.Decimal(6, 4)
  aliqIntermediacao Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao")
  aliqWL            Decimal? @db.Decimal(6, 4) @map("aliq_wl")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("sku_config")
}

// Cupons de desconto — migra o knob CUPONS de lib/cupons.ts. Desconto SEMPRE sobre o
// subtotal do produto (nunca frete); servidor é a autoridade única (validado no display
// E re-validado no checkout).
model Cupom {
  id             String    @id @default(cuid())
  codigo         String    @unique // armazenado em MAIÚSCULAS
  tipo           String // 'percentual' | 'fixo'
  valor          Decimal   @db.Decimal(10, 2) // percentual 0–100 · fixo BRL
  validadeInicio DateTime? @map("validade_inicio") @db.Date
  validadeFim    DateTime? @map("validade_fim") @db.Date
  minimo         Decimal?  @db.Decimal(10, 2)
  ativo          Boolean   @default(true)
  // 011: em qual vertical o cupom vale. Ausência de escopo NÃO é 'ambos' (FR-037) — senão
  // todo cupom vigente passa a valer para fita por omissão e drena a margem do parceiro.
  escopo         String    @default("porcelanato") // 'porcelanato' | 'fitas' | 'ambos'
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("cupons")
}

// Mapa de cadeiras — espelha o seats[] hard-coded do site (niche/status/open).
model Cadeira {
  id        String   @id @default(cuid())
  niche     String
  // ⚠️ `status` é TEXTO DE EXIBIÇÃO ('Ocupada · Tapepro'). Nenhuma decisão de máquina
  // pode lê-lo: casar substring de rótulo é a mesma classe de defeito que medir a
  // palavra `GPTBot` em vez da permissão. Para decidir, use `estado` (012).
  status    String
  open      Boolean  @default(false)
  ordem     Int      @default(0)
  polo      String   @default("Goiânia")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 012: estado da cadeira no ciclo de vendabilidade — o campo que MÁQUINA lê.
  estado String @default("vaga") // vaga | em-preparacao | ocupada-sem-produto | ocupada-vendavel

  // 012 FR-010: marcação interna, sempre. Cadeira da casa nunca gera success fee de si mesma.
  daCasa Boolean @default(false) @map("da_casa")
  // 012 FR-010a: exibição pública é INDEPENDENTE da marcação interna. Não derivar um do
  // outro — derivar apagaria a decisão do Jean. A lista de exceções (sirius/meridian/orion)
  // é DADO, nunca condição no código.
  exibirDaCasa Boolean @default(false) @map("exibir_da_casa")

  // 012: identidade do projeto que ocupa a cadeira. A chave é a URL DO SITE, não o repo —
  // 35 dos 36 repos têm site próprio, e é o site que se vende. Nulo = cadeira vaga
  // (Postgres aceita múltiplos nulos em @unique).
  siteUrl String? @unique @map("site_url")
  // ⚠️ SEM @@unique: `goiania` e `roilabs` são o MESMO repo servindo dois sites legítimos.
  // FR-011 vira TESTE (test/cadeira-repo-unico.test.mjs), não constraint — é lá que a
  // decisão aparece se um dia dois sites do mesmo repo forem duas cadeiras de verdade.
  repoUrl String? @map("repo_url")

  parceiros Parceiro[]
  produto   ProdutoCadeira?

  @@map("cadeiras")
}

// 012 §4.5 — o que se vende naquela cadeira. Fonte do preço do Offer (FR-013).
model ProdutoCadeira {
  id           String   @id @default(cuid())
  cadeiraId    String   @unique @map("cadeira_id") // ZERO OU UM por cadeira na fase 1
  nome         String
  descricao    String?
  preco        Decimal  @db.Decimal(10, 2)
  moeda        String   @default("BRL")
  recorrencia  String   @default("unica") // unica | mensal | anual
  modoCobranca String   @map("modo_cobranca") // carrinho | parceiro
  // Obrigatório quando modoCobranca='parceiro'. O Prisma não declara CHECK, então a
  // invariante é validação de servidor + teste (lib/carteira/produto.ts).
  checkoutUrl  String?  @map("checkout_url")
  publicado    Boolean  @default(false) // false ⇒ sem URL indexável e fora do sitemap (FR-009)
  updatedAt    DateTime @updatedAt @map("updated_at")

  cadeira Cadeira @relation(fields: [cadeiraId], references: [id])

  // ponytail: @unique em cadeiraId é o teto declarado — catálogo com múltiplos SKUs
  // continua exclusivo de porcelanato e fitas (FR-001). Upgrade: dropar o @unique
  // quando uma cadeira precisar de dois produtos; nada mais muda.
  @@map("produtos_cadeira")
}

// 012 §2 — a venda crua reportada pelo gateway do parceiro. Tabela nova, sem backfill.
model VendaParceiro {
  id          String  @id @default(cuid())
  // ⚠️ ANULÁVEL DE PROPÓSITO: null = não atribuída (FR-005, falha fechada). Com NOT NULL,
  // "registrar como não-atribuído" não tinha onde cair e a linha nasceria atribuída ao
  // parceiro ERRADO — exatamente o defeito que a falha fechada existe para impedir.
  parceiroId  String? @map("parceiro_id")
  gateway     String // mercadopago | stripe
  eventoId    String  @map("evento_id") // id do evento NO gateway
  pagamentoId String  @map("pagamento_id") // id do pagamento NO gateway
  valor       Decimal @db.Decimal(10, 2) // lido DO gateway, nunca do corpo (FR-003b)
  moeda       String  @default("BRL")
  status      String // aprovada | reembolsada | estornada
  recorrente  Boolean @default(false) // assinatura vs compra única — regra 1 da classificação
  clienteDoc  String? @map("cliente_doc") // CPF/CNPJ normalizado, quando o gateway dá
  clienteRef  String? @map("cliente_ref") // id/e-mail do cliente NO gateway
  payload     Json // cru, como chegou — sem ele um negócio disputado não se reconstrói
  motivoDescarte String? @map("motivo_descarte") // conta-divergente | payer-teste | null = venda boa
  recebidoEm  DateTime @default(now()) @map("recebido_em")

  parceiro Parceiro?          @relation(fields: [parceiroId], references: [id])
  negocios NegocioOriginado[]

  // ⚠️ A idempotência de FR-004 mora AQUI, no banco, não num `if` na rota: dois retries
  // simultâneos do gateway são o comportamento NORMAL deles, e checar-antes-de-gravar
  // é corrida entre os dois.
  @@unique([gateway, eventoId])
  @@index([parceiroId, clienteRef])
  @@map("vendas_parceiro")
}

// 012 §3 — onde mora o segredo por conta de parceiro. Não em `Parceiro`: um parceiro pode
// ter mais de uma conta, e segredo em tabela muito lida vaza em `select *`.
model CredencialGateway {
  id         String   @id @default(cuid())
  parceiroId String   @map("parceiro_id")
  gateway    String // mercadopago | stripe
  contaRef   String   @map("conta_ref") // user_id (MP) / account (Stripe)
  // ⚠️ O NOME da env var, NUNCA o valor. Segredo de webhook no banco é segredo num backup,
  // num dump de debug e no `select *` de qualquer admin.
  segredoRef String   @map("segredo_ref")
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  parceiro Parceiro @relation(fields: [parceiroId], references: [id])

  // ⚠️ Impede dois parceiros reivindicarem a mesma conta — sem isto a atribuição de uma
  // venda vira ambígua e o fee vai para o parceiro errado.
  @@unique([gateway, contaRef])
  @@index([parceiroId])
  @@map("credenciais_gateway")
}

// Parceiro (loja/prestador) que recebe repasses de uma cadeira/nicho. Camada 007.
// estagio: sondagem | ativa | riscada | pausada. contratoEm setado ⇒ ocupa a cadeira (derivado).
model Parceiro {
  id             String    @id @default(cuid())
  nome           String
  whatsapp       String?
  email          String?
  cpfCnpj        String?   @map("cpf_cnpj") // obrigatório só para faturar (cliente Asaas)
  cidade         String?
  nicho          String // derivado da Cadeira escolhida na criação
  polo           String    @default("Goiânia")
  cadeiraId      String?   @map("cadeira_id")
  candidaturaId  String?   @map("candidatura_id")
  estagio        String    @default("sondagem")
  // ponytail: comissaoPct deprecada (não lida no cálculo desde a 010); dropar num db push futuro se incomodar.
  comissaoPct         Decimal? @db.Decimal(6, 4) @map("comissao_pct") // DEPRECADO — substituído pelas duas taxas abaixo
  comissaoAquisicao   Decimal? @db.Decimal(6, 4) @map("comissao_aquisicao") // fração [0,1]; 1ª compra ganha do cliente
  comissaoRecorrencia Decimal? @db.Decimal(6, 4) @map("comissao_recorrencia") // fração [0,1]; compras seguintes
  contratoEm     DateTime? @db.Date @map("contrato_em")
  asaasCustomerId String?  @map("asaas_customer_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cadeira     Cadeira?          @relation(fields: [cadeiraId], references: [id])
  candidatura Candidatura?      @relation(fields: [candidaturaId], references: [id])
  negocios    NegocioOriginado[]
  faturas     FaturaSuccessFee[]
  // 012: relações inversas das tabelas novas. Sem elas o `prisma generate` FALHA — e ele
  // roda antes do `next build`.
  vendas      VendaParceiro[]
  credenciais CredencialGateway[]

  @@index([estagio])
  @@index([cadeiraId])
  @@map("parceiros")
}

// Negócio originado: um Pedido pago repassado a um Parceiro. Camada 007.
// estagio: repassado | aceito | ganho | perdido. Repasse único por pedido (regra na rota, FR-004a).
model NegocioOriginado {
  id             String   @id @default(cuid())
  // ⚠️ 012: ANULÁVEL — venda de cadeira SaaS nasce sem `Pedido` interno (FR-002).
  // Landmine conhecida desta casa: `where: { pedidoId: … }` que antes cobria 100% das
  // linhas passa a ignorar EM SILÊNCIO todo negócio de webhook, e `include: { pedido }`
  // passa a devolver null (`n.pedido.statusPagamento` explode). Toda leitura foi varrida
  // em T012/T013 — ao escrever consulta nova, decidir explicitamente o que fazer com
  // `origem='webhook'`.
  pedidoId       String?  @map("pedido_id")
  parceiroId     String   @map("parceiro_id")
  valor          Decimal  @db.Decimal(10, 2) // snapshot: total do pedido − frete (valor de produto)
  estagio        String   @default("repassado")
  faturavel      Boolean  @default(true) // isenção pontual ⇒ false
  isencaoMotivo  String?  @map("isencao_motivo")
  // Snapshot congelado na criação do negócio (010, FR-005).
  clienteDoc     String?  @map("cliente_doc") // CPF/CNPJ normalizado do comprador; null = sem doc → aquisição
  classificacao  String?  // aquisicao | recorrencia | legado (backfill)
  taxaAplicada   Decimal  @db.Decimal(6, 4) @map("taxa_aplicada") // fração [0,1] cobrada neste negócio (NOT NULL — T021)
  faturaId       String?  @map("fatura_id")

  // 012: de onde este negócio veio. 'pedido' = carrinho da ROI Labs (porcelanato/fitas);
  // 'webhook' = venda no gateway do parceiro, sem pedido interno.
  // ⚠️ O @default NÃO reescreve linha já gravada — o backfill explícito é
  // scripts/migrate-012-backfill.mjs.
  origem     String  @default("pedido") // pedido | webhook
  vendaId    String? @map("venda_id") // FK para VendaParceiro quando origem='webhook'
  // 012: chave de cliente quando o gateway não entrega documento (id/e-mail NO gateway).
  // `clienteDoc` continua sendo a preferida; esta é o fallback do passo 2 do contrato.
  // SEM backfill: nulo em linha antiga é o valor CORRETO.
  clienteRef String? @map("cliente_ref")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pedido   Pedido?            @relation(fields: [pedidoId], references: [id])
  parceiro Parceiro           @relation(fields: [parceiroId], references: [id])
  fatura   FaturaSuccessFee?  @relation(fields: [faturaId], references: [id])
  venda    VendaParceiro?     @relation(fields: [vendaId], references: [id])

  @@index([parceiroId])
  @@index([estagio])
  @@index([pedidoId])
  @@index([parceiroId, clienteDoc]) // achar negócios anteriores do mesmo cliente+parceiro (classificação)
  @@index([parceiroId, clienteRef]) // idem, quando o gateway não entrega documento (012)
  @@map("negocios_originados")
}

// 014: vínculo recorrente (Key Entity da spec). Nasce dentro da MESMA transação que marca
// o Pedido do 1º ciclo como pago (webhook) — nunca antes. itemPedidoId/pedidoId/lojaId são
// denormalizados de propósito, SEM @relation: evita join a mais nas leituras do admin; a
// fonte de verdade continua sendo itemPedidoId (ItemPedido não ganha coluna nova).
model Assinatura {
  id               String    @id @default(cuid())
  itemPedidoId     String    @unique @map("item_pedido_id")
  pedidoId         String    @map("pedido_id")
  slug             String
  lojaId           String    @map("loja_id")
  mpPreapprovalId  String    @unique @map("mp_preapproval_id")
  recorrencia      String // mensal | anual — snapshot, nunca relido da config da loja
  estado           String    @default("ativa") // ativa | inadimplente | cancelada (máquina de estado, data-model.md)
  proximaCobranca  DateTime? @map("proxima_cobranca") // null quando cancelada
  janelaFalhaDesde DateTime? @map("janela_falha_desde") // marcado na 1ª falha da sequência; limpo em sucesso
  cancelToken      String    @unique @map("cancel_token") // opaco, gerado 1x, nunca rotacionado (D3)
  canceladaEm      DateTime? @map("cancelada_em")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  ciclos CicloCobranca[]

  @@index([estado]) // o cron filtra por estado='inadimplente' todo dia
  @@map("assinaturas")
}

// 014: uma linha por tentativa de cobrança (inclui o 1º ciclo) — nunca deletado, é o
// registro financeiro (FR-007).
model CicloCobranca {
  id            String   @id @default(cuid())
  assinaturaId  String   @map("assinatura_id")
  dataTentativa DateTime @default(now()) @map("data_tentativa")
  resultado     String // sucesso | falha
  motivo        String? // status/detalhe do Payment quando falha; null em sucesso
  mpPaymentId   String   @unique @map("mp_payment_id") // idempotência (FR-006)

  assinatura Assinatura @relation(fields: [assinaturaId], references: [id])

  @@index([assinaturaId])
  @@map("ciclos_cobranca")
}

// Fatura mensal de success fee por parceiro + cobrança Asaas. Camada 007.
model FaturaSuccessFee {
  id             String   @id @default(cuid())
  parceiroId     String   @map("parceiro_id")
  competencia    String // 'YYYY-MM'
  base           Decimal  @db.Decimal(12, 2) // Σ valor dos negócios incluídos
  valor          Decimal  @db.Decimal(12, 2) // Σ (negócio.valor × negócio.taxaAplicada) — soma por negócio (010)
  status         String   @default("emitida") // emitida | paga | erro
  asaasPaymentId String?  @unique @map("asaas_payment_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parceiro Parceiro           @relation(fields: [parceiroId], references: [id])
  negocios NegocioOriginado[]

  @@unique([parceiroId, competencia])
  @@map("faturas_success_fee")
}
