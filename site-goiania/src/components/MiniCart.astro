---
// Client-only mini-cart drawer (D6). Built entirely in JS so the pre-rendered/indexable
// HTML of pSEO pages is untouched (FR-018) — nothing here renders server-side except its
// global styles. The header cart icon (.cart-link, from CartCount) opens it; the live
// count badge already lives in CartCount and reacts to the same roi-cart-change event.
---

<style is:global>
  .mini-cart-overlay {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55);
    opacity: 0; visibility: hidden; transition: opacity 0.2s ease; z-index: 60;
  }
  .mini-cart-overlay[data-open] { opacity: 1; visibility: visible; }
  .mini-cart {
    position: fixed; top: 0; right: 0; height: 100%; width: min(380px, 90vw);
    background: var(--ink-2); border-left: 1px solid var(--d-line);
    transform: translateX(100%); transition: transform 0.25s ease; z-index: 61;
    display: flex; flex-direction: column; box-shadow: -8px 0 30px rgba(0, 0, 0, 0.4);
  }
  .mini-cart[data-open] { transform: translateX(0); }
  .mini-cart__head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem 1.2rem; border-bottom: 1px solid var(--d-line);
  }
  .mini-cart__head h2 { font-size: 1.05rem; margin: 0; color: var(--d-text); }
  .mini-cart__close { background: none; border: 0; color: var(--d-muted); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .mini-cart__close:hover { color: var(--hivis); }
  .mini-cart__body { flex: 1; overflow-y: auto; padding: 0.8rem 1.2rem; }
  .mini-cart__line { display: flex; justify-content: space-between; gap: 0.8rem; padding: 0.7rem 0; border-bottom: 1px solid var(--d-line); }
  .mini-cart__line:last-child { border-bottom: 0; }
  .mini-cart__name { color: var(--d-text); font-size: 0.9rem; font-weight: 600; }
  .mini-cart__meta { color: var(--d-muted); font-size: 0.8rem; }
  .mini-cart__sub { color: var(--d-text); font-weight: 700; white-space: nowrap; font-size: 0.9rem; }
  .mini-cart__rm { background: none; border: 0; color: var(--d-muted); cursor: pointer; font-size: 0.75rem; text-decoration: underline; padding: 0; margin-top: 0.2rem; }
  .mini-cart__rm:hover { color: var(--hivis); }
  .mini-cart__empty { color: var(--d-muted); text-align: center; padding: 2.5rem 1rem; }
  .mini-cart__foot { padding: 1.1rem 1.2rem; border-top: 1px solid var(--d-line); display: grid; gap: 0.8rem; }
  .mini-cart__total { display: flex; justify-content: space-between; font-weight: 800; color: var(--d-text); }
  .mini-cart__grupo { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--d-muted); font-weight: 700; padding: 0.9rem 0 0.3rem; }
  .mini-cart__grupo:first-child { padding-top: 0; }
  .mini-cart__aviso {
    font-size: 0.78rem; color: var(--d-text); line-height: 1.5;
    background: color-mix(in srgb, var(--hivis) 14%, var(--ink-2));
    border: 1px solid var(--hivis); border-radius: 8px; padding: 0.65rem 0.8rem; margin-bottom: 0.9rem;
  }
</style>

<script>
  import { lines, removeItem, CART_EVENT } from '../lib/cart';
  import { lines as linesFitas, removeItem as removeFita, CART_FITAS_EVENT } from '../lib/cart-fitas';

  const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

  // Build the drawer once, client-side, appended to <body> (keeps pSEO HTML clean).
  const overlay = document.createElement('div');
  overlay.className = 'mini-cart-overlay';
  const drawer = document.createElement('aside');
  drawer.className = 'mini-cart';
  drawer.setAttribute('aria-label', 'Resumo do carrinho');
  drawer.innerHTML = `
    <div class="mini-cart__head">
      <h2>Seu carrinho</h2>
      <button type="button" class="mini-cart__close" aria-label="Fechar">&times;</button>
    </div>
    <div class="mini-cart__body"></div>
    <div class="mini-cart__foot" hidden>
      <div class="mini-cart__total"><span>Total produtos</span><span class="mini-cart__total-val">—</span></div>
      <a class="btn btn--primary mini-cart__cta" href="/carrinho/" style="width:100%;text-align:center;">Ver carrinho</a>
      <a class="btn btn--ghost mini-cart__cta-fitas" href="/carrinho-fitas/" style="width:100%;text-align:center;" hidden>Ver carrinho de fitas</a>
    </div>`;
  document.body.append(overlay, drawer);

  const body = drawer.querySelector<HTMLElement>('.mini-cart__body')!;
  const foot = drawer.querySelector<HTMLElement>('.mini-cart__foot')!;
  const totalVal = drawer.querySelector<HTMLElement>('.mini-cart__total-val')!;
  const cta = drawer.querySelector<HTMLAnchorElement>('.mini-cart__cta')!;
  const ctaFitas = drawer.querySelector<HTMLAnchorElement>('.mini-cart__cta-fitas')!;

  const linha = (nome: string, meta: string, slug: string, sub: string, tipo: string) => `
        <div class="mini-cart__line">
          <div>
            <div class="mini-cart__name">${nome}</div>
            <div class="mini-cart__meta">${meta}</div>
            <button type="button" class="mini-cart__rm" data-rm="${slug}" data-tipo="${tipo}">Remover</button>
          </div>
          <div class="mini-cart__sub">${sub}</div>
        </div>`;

  function render() {
    const ls = lines();
    const lf = linesFitas();
    if (ls.length === 0 && lf.length === 0) {
      body.innerHTML = '<p class="mini-cart__empty">Seu carrinho está vazio.</p>';
      foot.hidden = true;
      return;
    }

    // Verticais coexistem SEM se sobrescrever (chaves diferentes no localStorage), mas o
    // pedido é separado — dizer isso aqui evita a surpresa no checkout, onde o servidor
    // rejeita carrinho misto.
    const misto = ls.length > 0 && lf.length > 0;
    const html: string[] = [];
    if (misto) {
      html.push(
        '<p class="mini-cart__aviso">Você tem porcelanato e fitas no carrinho. São <strong>pedidos separados</strong>: o pagamento é feito um de cada vez, e nenhum dos dois se perde.</p>',
      );
    }
    if (ls.length) {
      if (misto) html.push('<div class="mini-cart__grupo">Porcelanato</div>');
      html.push(
        ...ls.map((l) =>
          linha(l.nome, `${l.caixas} cx · ${l.m2.toFixed(2).replace('.', ',')} m²`, l.slug, l.subtotalFmt, 'porcelanato'),
        ),
      );
    }
    if (lf.length) {
      if (misto) html.push('<div class="mini-cart__grupo">Fitas adesivas</div>');
      html.push(...lf.map((l) => linha(l.nome, `${l.rolos} rolo(s) · ${l.precoFmt}/rolo`, l.slug, l.subtotalFmt, 'fitas')));
    }
    body.innerHTML = html.join('');

    totalVal.textContent = brl(
      ls.reduce((s, l) => s + l.subtotal, 0) + lf.reduce((s, l) => s + l.subtotal, 0),
    );
    // Sem porcelanato no carrinho, o CTA principal é o de fitas — nada de mandar o
    // comprador para um carrinho vazio.
    cta.hidden = ls.length === 0;
    ctaFitas.hidden = lf.length === 0;
    foot.hidden = false;
  }

  function open() { render(); overlay.setAttribute('data-open', ''); drawer.setAttribute('data-open', ''); }
  function close() { overlay.removeAttribute('data-open'); drawer.removeAttribute('data-open'); }

  overlay.addEventListener('click', close);
  drawer.querySelector('.mini-cart__close')!.addEventListener('click', close);
  body.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.dataset.rm) return;
    if (t.dataset.tipo === 'fitas') removeFita(t.dataset.rm);
    else removeItem(t.dataset.rm);
    render();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // The header cart icon opens the drawer instead of navigating (link still works w/o JS).
  document.querySelectorAll<HTMLAnchorElement>('.cart-link').forEach((link) =>
    link.addEventListener('click', (e) => { e.preventDefault(); open(); }),
  );

  // Keep an open drawer fresh when either cart changes elsewhere.
  const refresh = () => { if (drawer.hasAttribute('data-open')) render(); };
  window.addEventListener(CART_EVENT, refresh);
  window.addEventListener(CART_FITAS_EVENT, refresh);
</script>
