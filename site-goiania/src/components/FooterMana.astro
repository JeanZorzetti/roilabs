---
// Footer da Maná Moda Social — marca própria, não o footer do porcelanato (015 T013).
---
<footer class="mana-footer">
  <div class="wrap mana-footer__inner">
    <p class="mana-footer__tag">
      Maná Moda Social — moda social masculina, direto de Goiânia para todo o Brasil.
    </p>
    <p class="mana-footer__meta">
      <a href="https://instagram.com/manamodasocial" target="_blank" rel="noopener" style="color:inherit">
        Instagram
      </a>
      &nbsp;·&nbsp;
      <a href="/mana/" style="color:inherit">Catálogo</a>
      &nbsp;·&nbsp;
      <a href="https://roilabs.com.br" target="_blank" rel="noopener" style="color:inherit">
        Loja operada pela ROI Labs
      </a>
    </p>
  </div>
</footer>

<style>
  .mana-footer {
    border-top: 1px solid var(--d-line);
    background: var(--ink);
    margin-top: 4rem;
  }
  .mana-footer__inner {
    padding-block: 2.2rem;
    display: grid;
    gap: 0.6rem;
  }
  .mana-footer__tag {
    color: var(--d-text);
    font-size: 0.95rem;
    margin: 0;
  }
  .mana-footer__meta {
    color: var(--d-muted);
    font-size: 0.85rem;
    margin: 0;
  }
</style>
