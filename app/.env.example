# Postgres (EasyPanel) — db roilabs_db, port 5443
DATABASE_URL="postgres://roilabs_db:CHANGE_ME@2.24.207.200:5443/roilabs_db?sslmode=disable"

# Single internal login (Task 1 decision: login único interno)
ADMIN_PASSWORD="set-a-strong-password"

# HMAC secret for the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-secret"

# Mercado Pago (Checkout Pro) — create preference, query payment, refund.
# Use TEST credentials for verification, production for go-live.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-or-TEST-access-token"
# Webhook signing secret (painel MP → Webhooks → assinatura secreta). Validates x-signature.
MERCADOPAGO_WEBHOOK_SECRET="webhook-signing-secret"
