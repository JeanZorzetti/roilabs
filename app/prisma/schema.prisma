// ROI Labs admin — Postgres (EasyPanel). snake_case tables via @@map (owner convention).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Candidaturas = leads do form do site. status: novo | curadoria | aprovado | recusado
model Candidatura {
  id        String   @id @default(cuid())
  nome      String
  empresa   String
  whatsapp  String
  cidade    String?
  categoria String?
  site      String?
  mensagem  String?
  status    String   @default("novo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("candidaturas")
}

// Lead de consumidor vindo do formulário das páginas pSEO de porcelanato.
model LeadConsumidor {
  id          String   @id @default(cuid())
  nome        String
  whatsapp    String
  produto     String?
  pagina      String?
  mensagem    String?
  consentLGPD Boolean  @default(false) @map("consent_lgpd")
  status      String   @default("novo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("leads_consumidor")
}

// Pedido de e-commerce de porcelanato (site Goiânia). pago = reserva até o fornecedor confirmar.
model Pedido {
  id                String   @id @default(cuid())
  nome              String
  whatsapp          String
  email             String?
  entrega           String // retirada | entrega | a_combinar
  cep               String?
  frete             Decimal? @db.Decimal(10, 2) // null = a combinar (FR-016)
  cupomCodigo       String?  @map("cupom_codigo") // snapshot do cupom aplicado; null se sem cupom
  desconto          Decimal? @db.Decimal(10, 2) // desconto recalculado no servidor (só sobre produto)
  total             Decimal  @db.Decimal(10, 2) // produto − desconto + frete (recalculado no servidor)
  statusPagamento   String   @default("pendente") @map("status_pagamento") // pendente | pago | reembolsado
  statusFulfillment String   @default("aguardando") @map("status_fulfillment") // aguardando | confirmado | reembolsado
  mpPreferenceId    String?  @map("mp_preference_id")
  mpPaymentId       String?  @unique @map("mp_payment_id") // chave de idempotência do webhook (D4)
  consent           Boolean  @default(false)

  itens     ItemPedido[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([statusPagamento])
  @@map("pedidos")
}

model ItemPedido {
  id       String  @id @default(cuid())
  pedidoId String  @map("pedido_id")
  slug     String
  caixas   Int
  m2       Decimal @db.Decimal(10, 2)
  precoM2  Decimal @db.Decimal(10, 2) @map("preco_m2") // snapshot do preço/m² na compra
  subtotal Decimal @db.Decimal(10, 2)

  // Snapshot congelado quando o pedido vira 'pago' (US4). NULL = pedido anterior à feature.
  pisoSnapshot              Decimal? @db.Decimal(10, 2) @map("piso_snapshot")
  modalidadeSnapshot        String?  @map("modalidade_snapshot") // 'wl'|'intermediacao'
  comissaoSnapshot          Decimal? @db.Decimal(6, 4) @map("comissao_snapshot")
  aliqIntermediacaoSnapshot Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao_snapshot")
  aliqWLSnapshot            Decimal? @db.Decimal(6, 4) @map("aliq_wl_snapshot")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("itens_pedido")
}

// Parâmetros dos centros de custo (global + linha). Campos nullable = herda a camada acima.
model ParametroCentroCusto {
  id                String   @id @default(cuid())
  escopo            String // 'global' | 'linha'
  chave             String? // null no global; nome da linha quando escopo='linha'
  markup            Decimal? @db.Decimal(6, 4)
  comissao          Decimal? @db.Decimal(6, 4)
  aliqIntermediacao Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao")
  aliqWL            Decimal? @db.Decimal(6, 4) @map("aliq_wl")
  cenario           String? // só no global: 'conservador'|'base'|'otimista'|'ajustado'
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([escopo, chave])
  @@map("parametro_centro_custo")
}

// Config por SKU: piso real, modalidade-alvo, overrides de parâmetro. Tudo opcional.
model SkuConfig {
  id                String   @id @default(cuid())
  slug              String   @unique
  linha             String? // nome de uma ParametroCentroCusto escopo=linha
  piso              Decimal? @db.Decimal(10, 2) // atacado real /m²; ausente = estimado por markup
  modalidadeAlvo    String?  @map("modalidade_alvo") // 'wl'|'intermediacao'; ausente = Intermediação
  markup            Decimal? @db.Decimal(6, 4)
  comissao          Decimal? @db.Decimal(6, 4)
  aliqIntermediacao Decimal? @db.Decimal(6, 4) @map("aliq_intermediacao")
  aliqWL            Decimal? @db.Decimal(6, 4) @map("aliq_wl")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("sku_config")
}

// Mapa de cadeiras — espelha o seats[] hard-coded do site (niche/status/open).
model Cadeira {
  id        String   @id @default(cuid())
  niche     String
  status    String
  open      Boolean  @default(false)
  ordem     Int      @default(0)
  polo      String   @default("Goiânia")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cadeiras")
}
