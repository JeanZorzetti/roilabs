---
// Sub-página do mural "Inspire-se" filtrada por ambiente (tarefa 5, macro
// plano 2). Curadoria manual em src/data/ambientes.ts — só ambientes com ≥4
// fotos viram página (hoje: sala e área externa).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { tituloProduto, imgDisplay } from '../../data/produtos';
import { ambientes, produtosDoAmbiente } from '../../data/ambientes';
import { imgDims } from '../../data/img-dims';

export function getStaticPaths() {
  return ambientes.map((a) => ({ params: { ambiente: a.slug }, props: { amb: a } }));
}

const { amb } = Astro.props;
// width/height intrínsecos: o masonry tem altura variável — sem eles é CLS.
const fotos = await Promise.all(
  produtosDoAmbiente(amb.slug).map(async (p) => {
    const img = imgDisplay(p.imagensAmbiente![0]);
    return { slug: p.slug, titulo: tituloProduto(p), img, ...(await imgDims(img)) };
  })
);
const outros = ambientes.filter((a) => a.slug !== amb.slug);

const SITE = Astro.site?.href.replace(/\/$/, '') ?? 'https://goiania.roilabs.com.br';
const jsonLdNodes = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Inspire-se', item: `${SITE}/inspire-se/` },
      { '@type': 'ListItem', position: 3, name: amb.nome, item: `${SITE}/inspire-se/${amb.slug}/` },
    ],
  },
];
---

<Base
  title={`${amb.titulo} — Goiânia | ROI Labs`}
  description={amb.descricao}
  ogImage="/open-graph/comparar.png"
  jsonLdNodes={jsonLdNodes}
>
  <Header />

  <main>
    <section class="pseo-hero">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Localização">
          <a href="/">Início</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <a href="/inspire-se/">Inspire-se</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <span aria-current="page">{amb.nome}</span>
        </nav>

        <div class="pseo-hero__eyebrow">
          <span class="eyebrow">Goiânia · Mural de ambientes</span>
        </div>
        <h1>{amb.titulo}</h1>
        <p class="pseo-hero__intro">{amb.descricao}</p>
        <p class="pseo-hero__intro">
          Ver também:
          {outros.map((o) => <a href={`/inspire-se/${o.slug}/`}>{o.nome}</a>)}
          · <a href="/inspire-se/">todos os ambientes</a>
        </p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="inspire-grid">
          {fotos.map((f) => (
            <a class="inspire-item" href={`/porcelanato/produto/${f.slug}/`}>
              <img src={f.img} alt={`${amb.nome} com ${f.titulo}`} width={f.width} height={f.height} loading="lazy" decoding="async" />
              <span class="inspire-item__label">{f.titulo}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--light" id="contato">
      <div class="wrap">
        <h2 style="font-size:clamp(1.5rem,2.8vw,2.2rem);margin-bottom:0.8rem;">
          Achou o ambiente ideal?
        </h2>
        <p style="color:var(--d-muted);margin-bottom:2rem;max-width:54ch;">
          Veja o catálogo completo com preço por m² e pronta-entrega no polo de Goiânia.
        </p>
        <a class="btn btn--primary" href="/porcelanato/">Ver catálogo de porcelanato</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .inspire-grid {
    columns: 4 260px;
    column-gap: 1rem;
  }
  .inspire-item {
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .inspire-item img {
    width: 100%;
    height: auto; /* attrs width/height só dão o aspect-ratio intrínseco */
    display: block;
  }
  .inspire-item__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.6rem 0.7rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  }
</style>
