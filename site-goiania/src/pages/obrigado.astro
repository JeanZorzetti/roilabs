---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Pedido recebido — ROI Labs Goiânia"
  description="Confirmação do seu pedido ou mensagem em ROI Labs Goiânia."
>
  <Header />
  <main class="thanks">
    <div class="wrap thanks__inner">
      <!-- Default: lead message (no ?pedido) -->
      <div class="thanks-lead">
        <span class="eyebrow thanks__eyebrow">Mensagem recebida</span>
        <h1>Entraremos em contato em breve.</h1>
        <p class="thanks__lead">
          Recebemos suas informações sobre porcelanato em Goiânia. Nossa equipe responde
          em até 24h úteis pelo WhatsApp que você informou.
        </p>
      </div>

      <!-- Order confirmation (shown when ?pedido= is present) -->
      <div class="thanks-pedido" hidden>
        <span class="eyebrow thanks__eyebrow thanks-pedido__eyebrow"></span>
        <h1 class="thanks-pedido__title"></h1>
        <p class="thanks__lead thanks-pedido__msg"></p>
        <p class="thanks-pedido__ref" style="font-family:monospace;color:var(--d-muted);font-size:0.85rem;"></p>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-top:1.5rem;">
        <a class="btn btn--ghost" href="/porcelanato">Ver mais porcelanatos</a>
        <a class="btn btn--primary" href="/">Início</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const pedido = params.get('pedido');
  // Mercado Pago appends collection_status / status to the back_url. Display only —
  // the authoritative status comes from the webhook (this page grants nothing).
  const status = params.get('collection_status') || params.get('status') || '';

  if (pedido) {
    document.querySelector<HTMLElement>('.thanks-lead')!.hidden = true;
    const box = document.querySelector<HTMLElement>('.thanks-pedido')!;
    box.hidden = false;

    const map: Record<string, { eyebrow: string; title: string; msg: string }> = {
      approved: {
        eyebrow: 'Pagamento aprovado',
        title: 'Pedido confirmado! 🎉',
        msg: 'Seu pagamento foi aprovado. O pedido entra como reserva: o fornecedor confirma a disponibilidade do lote em até 24h. Se faltar, o valor é reembolsado integralmente.',
      },
      pending: {
        eyebrow: 'Pagamento pendente',
        title: 'Quase lá.',
        msg: 'Estamos aguardando a confirmação do pagamento (por ex., o Pix pode levar alguns minutos). Assim que aprovado, seu pedido vira reserva.',
      },
      in_process: {
        eyebrow: 'Pagamento em análise',
        title: 'Pagamento em análise.',
        msg: 'Seu pagamento está sendo processado. Você será notificado assim que for aprovado.',
      },
      rejected: {
        eyebrow: 'Pagamento não concluído',
        title: 'Pagamento não concluído.',
        msg: 'O pagamento não foi aprovado. Seu carrinho foi preservado — você pode tentar novamente.',
      },
    };
    const info = map[status] || map['pending'];
    box.querySelector<HTMLElement>('.thanks-pedido__eyebrow')!.textContent = info.eyebrow;
    box.querySelector<HTMLElement>('.thanks-pedido__title')!.textContent = info.title;
    box.querySelector<HTMLElement>('.thanks-pedido__msg')!.textContent = info.msg;
    box.querySelector<HTMLElement>('.thanks-pedido__ref')!.textContent = `Pedido #${pedido}`;

    // On rejection the cart stays; otherwise clear it so a refresh doesn't re-buy.
    if (status === 'approved' || status === 'pending' || status === 'in_process') {
      localStorage.removeItem('roi_cart_v1');
    }
  }
</script>
