---
// Heart toggle used both floating over ProdutoCard's image and inline on the
// product page. One shared component so the hydration script only ships once
// per page (Astro dedupes <script> per component file).
interface Props {
  slug: string;
  nome: string;
  variant?: 'card' | 'inline';
}
const { slug, nome, variant = 'card' } = Astro.props;
---
<button
  type="button"
  class={`fav-toggle fav-toggle--${variant}`}
  data-fav-toggle={slug}
  aria-pressed="false"
  aria-label={`Favoritar ${nome}`}
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 21s-6.7-4.35-9.33-8.2C.86 10.1 1.4 6.6 4.2 5.1a5.5 5.5 0 0 1 7.3 1.6 5.5 5.5 0 0 1 7.3-1.6c2.8 1.5 3.34 5 1.53 7.7C18.7 16.65 12 21 12 21z" />
  </svg>
  <span class="fav-toggle__label">Favoritar</span>
</button>

<style>
  .fav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    cursor: pointer;
    color: inherit;
    background: none;
  }
  .fav-toggle svg { flex: none; }
  .fav-toggle[aria-pressed="true"] { color: var(--hivis); }
  .fav-toggle[aria-pressed="true"] svg { fill: currentColor; }

  .fav-toggle--card {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2rem;
    height: 2rem;
    justify-content: center;
    border-radius: 999px;
    background: color-mix(in srgb, #000 40%, transparent);
    color: #fff;
  }
  .fav-toggle--card .fav-toggle__label { display: none; }
  .fav-toggle--card:hover { color: var(--hivis); }

  .fav-toggle--inline {
    padding: 0.6rem 0.9rem;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 8px;
    font: inherit;
    font-size: 0.95rem;
  }
  .fav-toggle--inline:hover { border-color: var(--hivis); color: var(--hivis); }
</style>

<script>
  import { isFavorito, toggleFavorito, FAV_EVENT } from '../lib/favoritos';

  function sync() {
    document.querySelectorAll<HTMLButtonElement>('[data-fav-toggle]').forEach((btn) => {
      const slug = btn.dataset.favToggle!;
      const on = isFavorito(slug);
      btn.setAttribute('aria-pressed', String(on));
      const label = btn.querySelector('.fav-toggle__label');
      if (label) label.textContent = on ? 'Favoritado' : 'Favoritar';
    });
  }
  sync();

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-fav-toggle]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    toggleFavorito(btn.dataset.favToggle!);
    sync();
  });

  window.addEventListener(FAV_EVENT, sync);
  window.addEventListener('storage', sync);
</script>
