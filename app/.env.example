# Postgres (EasyPanel) — db roilabs_db, port 5443
DATABASE_URL="postgres://roilabs_db:CHANGE_ME@2.24.207.200:5443/roilabs_db?sslmode=disable"

# Single internal login (Task 1 decision: login único interno)
ADMIN_PASSWORD="set-a-strong-password"

# HMAC secret for the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-secret"

# Mercado Pago (Checkout Pro) — create preference, query payment, refund.
# Use TEST credentials for verification, production for go-live.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-or-TEST-access-token"
# Webhook signing secret (painel MP → Webhooks → assinatura secreta). Validates x-signature.
MERCADOPAGO_WEBHOOK_SECRET="webhook-signing-secret"

# Asaas (cobrança de success fee — camada 007). Sandbox por padrão; trocar ASAAS_API_URL
# para produção só depois de validar em sandbox (Const. II).
ASAAS_API_KEY="asaas-api-key-sandbox-ou-producao"
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
# Token configurado no painel Asaas (Integrações → Webhooks). Validado no header asaas-access-token.
ASAAS_WEBHOOK_TOKEN="asaas-webhook-token"

# E-mail transacional (Resend free tier). SEM a chave, e-mails viram no-op (nada quebra).
# Confirmação de pedido pro cliente + alerta interno de lead/pedido novo.
RESEND_API_KEY="re_..."
# Remetente. Domínio precisa estar verificado no Resend; até lá vale onboarding@resend.dev.
EMAIL_FROM="ROI Labs <pedidos@roilabs.com.br>"
# Destino dos alertas internos (lead/candidatura/pedido pago).
ALERT_EMAIL="roilabs.ia@gmail.com"
