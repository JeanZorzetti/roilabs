---
// Header favorites link with a live count badge — same layout mechanics as
// CartCount, but with its OWN scoped <style> (Astro scopes styles per
// component via data-astro-cid; reusing CartCount's class names here without
// this block gets zero CSS from it, styled-cart-next-to-unstyled-heart —
// see astro_scoped_styles_innerhtml_gotcha). Distinct hover/active color
// (pink/rosa) so it doesn't just read as "another cart icon".
---
<a class="fav-link" href="/favoritos/" aria-label="Favoritos">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 21s-6.7-4.35-9.33-8.2C.86 10.1 1.4 6.6 4.2 5.1a5.5 5.5 0 0 1 7.3 1.6 5.5 5.5 0 0 1 7.3-1.6c2.8 1.5 3.34 5 1.53 7.7C18.7 16.65 12 21 12 21z" />
  </svg>
  <span class="fav-link__badge" hidden>0</span>
</a>

<style>
  .fav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: inherit;
    padding: 0.25rem;
  }
  .fav-link:hover { color: #e0457b; }
  .fav-link__badge {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.25rem;
    background: #e0457b;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.1rem;
    text-align: center;
    border-radius: 999px;
  }
</style>

<script>
  import { countFavoritos, FAV_EVENT } from '../lib/favoritos';

  const badge = document.querySelector<HTMLElement>('.fav-link__badge');
  function update() {
    if (!badge) return;
    const n = countFavoritos();
    badge.textContent = String(n);
    badge.hidden = n === 0;
  }
  update();
  window.addEventListener(FAV_EVENT, update);
  window.addEventListener('storage', update);
</script>
