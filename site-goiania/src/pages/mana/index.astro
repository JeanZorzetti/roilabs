---
// Vitrine da Maná Moda Social (015 T016). Design próprio — não o layout do porcelanato
// com outro texto (Constituição IV). Cadeira segue publicada:false: sem botão de compra
// em lugar nenhum desta página até a Fase 7.
import Base from '../../layouts/Base.astro';
import HeaderMana from '../../components/HeaderMana.astro';
import FooterMana from '../../components/FooterMana.astro';
import { produtosMana } from '../../data/mana';

const SITE_MANA = 'https://mana.roilabs.com.br';

const itemList = {
  '@type': 'ItemList',
  '@id': `${SITE_MANA}/mana/#lista`,
  name: 'Moda social masculina Maná',
  numberOfItems: produtosMana.length,
  itemListElement: produtosMana.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_MANA}/mana/${p.slug}/`,
    name: p.nome,
  })),
};
---

<Base
  title="Moda social masculina — camisas, calça e terno | Maná Moda Social"
  description="Camisa social, calça social e terno em poliviscose para o dia que pede formalidade. Corte clássico, acabamento premium, envio para todo o Brasil."
  siteBase={SITE_MANA}
  jsonLdNodes={[itemList]}
>
  <HeaderMana />

  <main class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow" style="color:var(--mana-accent, var(--hivis));display:block;margin-bottom:1rem;">
          Maná Moda Social
        </span>
        <h1>Moda social masculina, sem complicar</h1>
        <p class="section__lead" style="color:var(--d-muted);max-width:62ch;">
          Camisas, calça e terno para o compromisso do dia a dia e para a ocasião que pede
          um passo a mais. Corte clássico, acabamento premium, envio para todo o Brasil.
        </p>
      </div>

      <ul class="mana-grid">
        {
          produtosMana.map((p) => (
            <li class="mana-card">
              <a href={`/mana/${p.slug}/`} class="mana-card__link">
                <img
                  class="mana-card__img"
                  src={p.imagens[0]}
                  alt={p.alt}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
                <div class="mana-card__body">
                  <span class="mana-card__categoria">{p.categoria}</span>
                  <h2 class="mana-card__nome">{p.nome}</h2>
                  <p class="mana-card__chamada">{p.chamadaVitrine}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <FooterMana />
</Base>

<style>
  .mana-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .mana-card {
    border: 1px solid var(--d-line);
    border-radius: 12px;
    background: var(--ink-2);
    overflow: hidden;
    transition: border-color 0.18s ease;
  }
  .mana-card:hover { border-color: var(--mana-accent, var(--hivis)); }
  .mana-card__link { display: block; text-decoration: none; color: inherit; }
  .mana-card__img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; background: var(--ink-3); }
  .mana-card__body { padding: 1.2rem 1.3rem 1.4rem; }
  .mana-card__categoria {
    display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--d-muted); margin-bottom: 0.4rem;
  }
  .mana-card__nome { font-size: 1.15rem; margin: 0 0 0.5rem; color: var(--d-text); }
  .mana-card__chamada { font-size: 0.9rem; color: var(--d-text); margin: 0; font-weight: 600; }
</style>
