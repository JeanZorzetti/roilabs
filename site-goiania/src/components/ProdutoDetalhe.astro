---
import WhatsappCta from './WhatsappCta.astro';
import AddToCart from './AddToCart.astro';
import { nomeProduto, formatPreco, imgDisplay, type Produto } from '../data/produtos';

interface Props {
  produto: Produto;
  headingTag?: 'h1' | 'h2';
}
const { produto, headingTag = 'h1' } = Astro.props;
const Heading = headingTag;

const a = produto.atributos;
const nome = nomeProduto(produto);
const tituloProduto = `${a.marca} ${nome}`;
const whatsapp = import.meta.env.PUBLIC_WHATSAPP ?? '5562993265713';
---
<div class="prod-detail">
  <!-- Galeria (exibição em .webp; data-full guarda o original pro zoom) -->
  <div class="prod-detail__gallery">
    <button class="prod-detail__main" type="button" aria-label={`Ampliar foto de ${tituloProduto}`}>
      <img src={imgDisplay(produto.imagens[0])} data-full={produto.imagens[0]} alt={tituloProduto} />
    </button>
    {produto.imagens.length > 1 && (
      <div class="prod-detail__thumbs">
        {produto.imagens.slice(0, 5).map((src, i) => (
          <img src={imgDisplay(src)} data-full={src} alt={`${tituloProduto} — foto ${i + 1}`} loading="lazy" />
        ))}
      </div>
    )}
  </div>

  <!-- Zoom nativo: porcelanato é textura, ver grande decide compra -->
  <dialog class="img-zoom">
    <button class="img-zoom__close" type="button" aria-label="Fechar">✕</button>
    <img src="" alt={tituloProduto} />
  </dialog>

  <script>
    // Zoom (dialog nativo, top-layer passa por cima do MiniCart) + thumbs
    // trocam a foto principal. Zoom mostra o ORIGINAL (data-full), não a webp.
    const detail = document.querySelector('.prod-detail');
    const main = detail?.querySelector<HTMLImageElement>('.prod-detail__main img');
    const dlg = detail?.querySelector<HTMLDialogElement>('.img-zoom');
    const dlgImg = dlg?.querySelector('img');
    if (main && dlg && dlgImg) {
      main.closest('button')?.addEventListener('click', () => {
        dlgImg.src = main.dataset.full ?? main.src;
        dlg.showModal();
      });
      dlg.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === dlg || t.closest('.img-zoom__close')) dlg.close();
      });
      detail?.querySelectorAll<HTMLImageElement>('.prod-detail__thumbs img').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          main.src = thumb.src;
          main.dataset.full = thumb.dataset.full ?? thumb.src;
        });
      });
    }
  </script>

  <!-- Info + ficha + CTA -->
  <div class="prod-detail__info">
    <span class="eyebrow" style="color:var(--hivis);display:block;margin-bottom:0.8rem;">{a.marca} · Goiânia</span>
    <Heading style="font-size:clamp(1.8rem,4vw,3rem);">{nome}</Heading>
    <p class="prod-detail__preco">{formatPreco(a.preco)} <small>/m²</small></p>

    <table class="attrs-table" style="margin:1.8rem 0;">
      <tbody>
        <tr><th scope="row">Marca</th><td>{a.marca}</td></tr>
        <tr><th scope="row">Dimensão</th><td>{a.dimensao}</td></tr>
        <tr><th scope="row">Acabamento</th><td>{a.acabamento}</td></tr>
        <tr><th scope="row">m² por caixa</th><td>{a.m2_caixa} m²</td></tr>
        {a.classe_ad != null && (
          <tr><th scope="row">Classe de Abrasão (AD)</th><td>{a.classe_ad}</td></tr>
        )}
        {a.retificado != null && (
          <tr><th scope="row">Retificado</th><td>{a.retificado ? 'Sim' : 'Não'}</td></tr>
        )}
      </tbody>
    </table>

    <!-- Calculadora pré-preenchida: o produto já sabe seu m²/caixa — o usuário só mede o ambiente. -->
    <p class="prod-detail__calc">
      <a href={`/calculadora/?m2caixa=${a.m2_caixa}&produto=${produto.slug}&nome=${encodeURIComponent(tituloProduto)}`}>
        Quantas caixas preciso? Calcular com este porcelanato →
      </a>
      <br />
      <a href={`/comparar/?p=${produto.slug}`}>
        Na dúvida? Comparar com outro porcelanato →
      </a>
    </p>

    <div class="cta-block">
      <AddToCart slug={produto.slug} m2Caixa={a.m2_caixa} preco={a.preco} />
      <WhatsappCta termoAlvo={tituloProduto} numero={whatsapp} />
    </div>
  </div>
</div>

<!-- Ambiente + vídeo (ciclo 11 item 5) — cobertura parcial por design: só
     produtos com foto oficial do fabricante confirmada (fetch-ambiente.mjs). -->
{(produto.imagensAmbiente?.[0] || produto.video) && (
  <div class="prod-ambiente">
    {produto.imagensAmbiente?.[0] && (
      <figure class="prod-ambiente__foto">
        <img src={imgDisplay(produto.imagensAmbiente[0])} alt={`${tituloProduto} aplicado em ambiente`} loading="lazy" />
        <figcaption>Veja em ambiente — foto do fabricante</figcaption>
      </figure>
    )}
    {produto.video && (
      <div class="prod-ambiente__video">
        <iframe
          src={produto.video}
          title={`Vídeo — ${tituloProduto}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}
  </div>
)}
