---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  jsonLdNodes?: Record<string, unknown>[];
  noindex?: boolean;
  /** Imagem do LCP (1ª foto de produto). Sem preload o browser só a descobre ao
   *  parsear o corpo, e ela entra na fila atrás dos scripts de analytics —
   *  era 41% do LCP da malha (Load Delay 1,56s). Só passe se ela estiver na 1ª dobra. */
  preloadImage?: string;
}

const {
  title = 'Porcelanato em Goiânia — ROI Labs',
  description = 'Encontre o porcelanato ideal para sua obra em Goiânia. Curadoria de tipos, ocasiões e atributos técnicos. Fale pelo WhatsApp ou solicite um orçamento.',
  ogType = 'website',
  ogImage = '/og-image.jpg',
  jsonLdNodes = [],
  noindex = false,
  preloadImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Caminho local resolve no site; URL absoluta passa intacta.
// Dimensões 1200×630 só valem pras imagens de social (estática + open-graph
// geradas) — foto de produto self-hosted (/img/) tem proporção própria.
const ogImageUrl = new URL(ogImage, Astro.site);
const ogImageLocal = ogImage === '/og-image.jpg' || ogImage.startsWith('/open-graph/');

const ORG_ID = 'https://roilabs.com.br/#org';
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'ROI Labs',
      url: 'https://roilabs.com.br/',
      email: 'parceria@roilabs.com.br',
      description:
        'Growth Partner para fornecedores regionais: operação de vendas online sem custo fixo, remuneração 100% variável. Polo 1: Goiânia, nicho revestimentos/porcelanato.',
      logo: { '@type': 'ImageObject', url: 'https://roilabs.com.br/roilabs-icon.png' },
      areaServed: { '@type': 'City', name: 'Goiânia' },
      slogan: 'Construímos sua venda online. Você paga quando vende.',
      sameAs: [
        'https://www.linkedin.com/company/roi-labs-curadoria/',
        'https://www.instagram.com/roilabs.curadoria/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://goiania.roilabs.com.br/#website',
      url: 'https://goiania.roilabs.com.br/',
      name: 'ROI Labs — Porcelanato Goiânia',
      inLanguage: 'pt-BR',
      publisher: { '@id': ORG_ID },
      // Busca interna (SiteSearch): ?q= abre o painel pré-preenchido em qualquer página.
      // Habilita sitelinks searchbox e declara a busca pros crawlers de IA.
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://goiania.roilabs.com.br/?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
    ...jsonLdNodes,
  ],
};

// Botão flutuante de WhatsApp (todas as páginas): cai no listener delegado de
// whatsapp_click abaixo, então já conta como conversão sem código extra.
const waFloat = `https://wa.me/${import.meta.env.PUBLIC_WHATSAPP ?? '5562993265713'}?text=${encodeURIComponent(
  'Olá! Estou no site de porcelanato de Goiânia e quero uma ajuda.'
)}`;

// GA4 (mesma Google tag do institucional — fluxos da mesma propriedade). Fallback
// hard-coded de propósito: vale sem env na EasyPanel; PUBLIC_GA_ID sobrepõe.
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-7JD9J2QEDJ';
// Clarity projeto "Goiânia - ROI Labs". Fallback hard-coded (igual ao gaId);
// PUBLIC_CLARITY_ID sobrepõe.
const clarityId = import.meta.env.PUBLIC_CLARITY_ID ?? 'xgun692iah';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Posse nativa no Bing. Sem ela o IndexNow devolve 403: a verificação importada do
        GSC vale na UI do Webmaster, mas o IndexNow não a honra. Ver Docs/Obsidian/80-dev/bing-webmaster.md */}
    <meta name="msvalidate.01" content="9E40520DFE09119E7EB8E15A8ED12DEB" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/roilabs-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Guias de porcelanato — ROI Labs Goiânia" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageLocal && <meta property="og:image:width" content="1200" />}
    {ogImageLocal && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#14171d" />
    <!-- Pinterest domain claim (Catalogs) — ver Docs/Obsidian/80-dev/pinterest-catalog.md -->
    <meta name="p:domain_verify" content="3dd6026641aaefa74ec8d188c3c1a135" />

    <!-- Fontes self-hosted em public/fonts (@font-face em src/styles/fonts.css).
         Sem preload o browser só descobre a fonte DEPOIS de parsear o CSS (HTML → CSS
         → fonte, em série). Hanken é o corpo e Archivo é o H1 — as duas pintam na 1ª
         dobra, então as duas vêm por preload e começam junto com o HTML. Space Mono
         (eyebrow) fica pra trás de propósito: é texto pequeno, aguenta o swap. -->
    <link rel="preload" href="/fonts/hanken-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- O tracker vem do cdn e depois bate no app: sem isso o beacon abre conexão
         nova no meio do carregamento (176ms, medidos pelo Lighthouse). -->
    <link rel="preconnect" href="https://app.himetrica.com" />
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <script is:inline define:vars={{ gaId, clarityId }}>
      // GA4 (mesma Google tag do institucional) + Microsoft Clarity (heatmap/sessão):
      // himetrica diz O QUE converte, Clarity mostra ONDE o funil vaza.
      //
      // Os dois BAIXAM depois do `load`, não durante o carregamento. Só o gtag.js são
      // 161KB — junto com o Clarity era o que sobrava do LCP da malha, roubando banda
      // da foto do produto (o elemento do LCP) e travando o main thread pra pintá-la.
      // Nada se perde: dataLayer e window.clarity são filas, criadas aqui de imediato;
      // quando os scripts chegam eles processam o que foi enfileirado (é o padrão dos
      // dois fornecedores). O himetrica continua carregando cedo — é ele que mede a
      // conversão de WhatsApp, e são só 4KB.
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };

      if (gaId) {
        gtag('js', new Date());
        gtag('config', gaId);
      }

      function carregarAnalytics() {
        if (gaId) {
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(g);
        }
        if (clarityId) {
          var c = document.createElement('script');
          c.async = true;
          c.src = 'https://www.clarity.ms/tag/' + clarityId;
          document.head.appendChild(c);
        }
      }
      if (document.readyState === 'complete') carregarAnalytics();
      else addEventListener('load', carregarAnalytics, { once: true });
    </script>

    <script is:inline defer src="https://cdn.himetrica.com/tracker.js" data-api-key="hm_ff2a6a72cb6b63d54c8799d1dad7b24e4263b1e5882f872f"></script>
    <script is:inline>
      // Conversion: any wa.me click on any page = lead intent; pathname identifies the combo.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="https://wa.me/"]') : null;
        if (a && window.himetrica) window.himetrica.track('whatsapp_click', { page: location.pathname });
      });
      // First-touch attribution: 1ª página de entrada (query preserva UTMs) + referrer
      // externo, gravados uma única vez. Forms consomem via input[name=origem] (nativos)
      // ou lendo localStorage.rlft direto (POSTs via fetch).
      try {
        if (!localStorage.rlft) {
          var ref = '';
          try { ref = document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).host : ''; } catch (_) {}
          localStorage.rlft = (location.pathname + location.search + (ref ? ' ← ' + ref : '')).slice(0, 300);
        }
      } catch (_) {}
      document.addEventListener('DOMContentLoaded', function () {
        var v = '';
        try { v = localStorage.rlft || ''; } catch (_) {}
        if (!v) return;
        document.querySelectorAll('input[name="origem"]').forEach(function (i) { i.value = v; });
      });
    </script>
  </head>
  <body>
    <slot />
    <a class="wa-float" href={waFloat} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
      <svg viewBox="0 0 32 32" width="30" height="30" fill="#fff" aria-hidden="true">
        <path d="M16 3C9.4 3 4 8.3 4 14.9c0 2.6.8 5 2.3 7L4 29l7.3-2.3c1.5.8 3.1 1.2 4.7 1.2 6.6 0 12-5.3 12-11.9S22.6 3 16 3zm0 21.8c-1.5 0-3-.4-4.3-1.2l-.3-.2-4.3 1.4 1.4-4.2-.2-.3c-1.2-1.6-1.8-3.5-1.8-5.4C6.5 9.5 10.8 5.2 16 5.2s9.5 4.3 9.5 9.7-4.3 9.9-9.5 9.9zm5.3-7.3c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.4z"/>
      </svg>
    </a>
    <style>
      .wa-float {
        position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 50;
        width: 56px; height: 56px; border-radius: 50%;
        background: #25d366; display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
        transition: transform 0.15s ease;
      }
      .wa-float:hover { transform: scale(1.07); }
      @media print { .wa-float { display: none; } }
    </style>
  </body>
</html>
