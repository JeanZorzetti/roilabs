---
// Header da Maná Moda Social — marca própria, não o header do porcelanato (015 T013).
// ponytail: sem CartCount/MiniCart aqui — a loja segue publicada:false (sem caminho de
// compra) e o carrinho é por origem (localStorage), então hoje sempre mostraria zero.
// Religar quando a Fase 7 publicar e AddToCart deixar de estar oculto.
---
<header class="mana-header">
  <div class="wrap mana-header__inner">
    <a class="mana-brand" href="/mana/" aria-label="Maná Moda Social, página inicial">
      <span class="mana-brand__nome">Maná</span>
      <span class="mana-brand__sub">Moda Social</span>
    </a>
    <nav class="mana-nav" aria-label="Principal">
      <a class="mana-nav__link" href="/mana/">Catálogo</a>
      <a class="mana-nav__link" href="https://instagram.com/manamodasocial" target="_blank" rel="noopener">
        Instagram
      </a>
    </nav>
  </div>
</header>

<style>
  .mana-header {
    border-bottom: 1px solid var(--d-line);
    background: var(--ink);
  }
  .mana-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }
  .mana-brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--d-text);
  }
  .mana-brand__nome {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .mana-brand__sub {
    font-size: 0.78rem;
    color: var(--d-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .mana-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .mana-nav__link {
    color: var(--d-text);
    text-decoration: none;
    font-size: 0.92rem;
    opacity: 0.85;
  }
  .mana-nav__link:hover,
  .mana-nav__link:focus-visible {
    opacity: 1;
    color: var(--mana-accent, var(--hivis));
  }
</style>
