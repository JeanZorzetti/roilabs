---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// 012/T057b — as cadeiras de PROJETO, no MESMO grid do mapa de nichos. Arquivo GERADO de
// app/src/lib/seats.ts (`cd app && npm run gen:carteira`), nunca escrito à mão: espelho
// manual foi o que deixou o conserto da API invisível aqui.
import { carteira } from '../data/carteira';
// Direção de arte Brasil Inteiro (28/09/2026): tokens e estilos só desta página, dentro de
// [data-art="brasil-inteiro"]. As outras páginas seguem no global.css até a home ser aprovada.
import '../styles/brasil-inteiro/tokens.css';
import '../styles/brasil-inteiro/home.css';

// Cadeiras de fornecedor e contatos moram em src/data/ porque o rodapé usa os mesmos dados.
import { fornecedores as seats } from '../data/fornecedores';
import { EMAIL, whatsLink } from '../data/contato';

const apply = `mailto:${EMAIL}?subject=Candidatura%20%C3%A0%20cadeira`;
const whatsHref = whatsLink();
// Quem terminou o teste da cadeira com algum ponto em aberto e quer conversar mesmo assim.
const whatsTeste = whatsLink('Fiz o teste da cadeira no site e quero conversar sobre o meu nicho');

// Candidaturas vão para o app admin (app.roilabs.com.br), que grava no DB.
// POST urlencoded simples (sem preflight CORS); a API redireciona pro `redirect`.
const CANDIDATURAS_ENDPOINT = 'https://app.roilabs.com.br/api/candidaturas';

// Mapa de cadeiras: o skeleton estático sai de src/data/fornecedores.ts (espelho de DEFAULT_SEATS,
// ver o comentário lá); a verdade ao vivo vem de /api/cadeiras no navegador.
const ocupada = (s: { estado: string }) => s.estado.startsWith('ocupada');
const aceitaCandidatura = (s: { estado: string; open: boolean }) => s.estado === 'vaga' && s.open;
// Texto de estado das cadeiras de projeto. Duplicado no <script is:inline> abaixo de
// propósito: o inline não compartilha escopo com o frontmatter, e são 2 linhas.
const ESTADO: Record<string, string> = { 'ocupada-vendavel': 'No ar', 'em-preparacao': 'Em preparação' };

// Mapa de cadeiras em DUAS divisões (Maria, 28/09/2026): as de clientes (empresas que contrataram
// a ROI Labs: os fornecedores e as cadeiras de projeto com `grupo: 'cliente'`) e as da ROI Labs
// (softwares e a agência). O card é o mesmo nas duas, com a legenda `estado · nome`.
type CardCadeira = { niche: string; estado: string; open: boolean; nome: string; siteUrl: string; rotulo: string };
const mapaClientes: CardCadeira[] = [
  ...seats.map((s) => ({
    niche: s.niche,
    estado: s.estado,
    open: s.open,
    nome: s.status.split('·').pop()!.trim(),
    siteUrl: s.href ?? '',
    rotulo: 'parceiro',
  })),
  ...carteira.filter((c) => c.grupo === 'cliente').map((c) => ({ ...c, open: false })),
];
const mapaRoiLabs: CardCadeira[] = carteira.filter((c) => c.grupo === 'roilabs').map((c) => ({ ...c, open: false }));
const divisoesDoMapa = [
  {
    titulo: 'Cadeiras de clientes',
    lead: 'Empresas que contrataram a ROI Labs: construímos e operamos a venda online delas.',
    cards: mapaClientes,
  },
  {
    titulo: 'Cadeiras da ROI Labs',
    lead: 'Softwares e serviços próprios, construídos e operados com o mesmo método de captação.',
    cards: mapaRoiLabs,
  },
];

// Vitrine do hero: as cadeiras ocupadas que têm foto da página no ar em
// public/art/brasil-inteiro/vitrine/ (tiradas à mão em 28/09/2026: 1440×900, topo da página, WebP 880×550).
// Nome, nicho e link saem dos mesmos dados do mapa de cadeiras; cadeira nova só aparece aqui com foto.
// O Orion fica fora: a página dele rola sozinha ao carregar e a foto sai no meio.
// Autogestor, Viagens e Coopluz entraram em 28/09/2026 (fotos em headless, mesmo enquadramento).
// O Vértice saiu da vitrine por hora, a pedido da dona; a foto segue em vertice.webp para voltar.
const FOTO: Record<string, string> = {
  Tapepro: 'tapepro',
  'Use Aligner': 'usealigner',
  'Polaris IA': 'polaris',
  'Estetia CRM': 'estetia',
  'Sirius CRM': 'sirius',
  Autogestor: 'autogestor',
  'Autogestor Viagens': 'viagens',
  Coopluz: 'coopluz',
};
// Ordem da vitrine escolhida pela dona (28/09/2026): estas primeiro, nesta ordem; o resto vem
// depois na ordem dos dados. Cadeira que não está aqui não some, só vai para o fim.
const ORDEM_VITRINE = ['Sirius CRM', 'Use Aligner', 'Tapepro'];
const posicao = (nome: string) => {
  const i = ORDEM_VITRINE.indexOf(nome);
  return i < 0 ? ORDEM_VITRINE.length : i;
};
const vitrine = [
  ...seats.filter(ocupada).map((s) => ({ nome: s.status.split('·').pop()!.trim(), nicho: s.niche, href: s.href ?? '#cadeiras' })),
  ...carteira.filter(ocupada).map((c) => ({ nome: c.nome, nicho: c.niche, href: c.siteUrl })),
]
  .flatMap((v) => (FOTO[v.nome] ? [{ ...v, foto: FOTO[v.nome] }] : []))
  .sort((a, b) => posicao(a.nome) - posicao(b.nome)); // sort estável: o resto mantém a ordem

// Nó próprio da home no @graph: o serviço Growth Partner (Base entrega Organization + WebSite).
const jsonLdNodes = [
  {
    '@type': 'Service',
    '@id': 'https://roilabs.com.br/#service',
    name: 'Growth Partner — operação de vendas online com success fee',
    serviceType: 'Operação de vendas online (SEO programático de alta intenção)',
    description:
      'A ROI Labs constrói e opera a venda online de um fornecedor regional por nicho: páginas de alta intenção validadas por volume real de busca, com tecnologia e tráfego bancados pela ROI Labs. O fornecedor paga a anuidade simbólica da cadeira (R$ 2.640/ano) e um success fee sobre a venda concretizada. Exclusividade de cadeira: uma empresa por nicho no Brasil.',
    provider: { '@id': 'https://roilabs.com.br/#org' },
    areaServed: { '@type': 'Country', name: 'Brasil' },
    offers: {
      '@type': 'Offer',
      description:
        'Anuidade da cadeira de R$ 2.640/ano (R$ 220/mês) mais fração variável sobre a venda concretizada, com SLA de estoque e despacho.',
      price: '2640.00',
      priceCurrency: 'BRL',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '2640.00',
        priceCurrency: 'BRL',
        referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'ANN' },
      },
    },
  },
];
---

<Base jsonLdNodes={jsonLdNodes} fontesPadrao={false}>
  <Fragment slot="head">
    <!-- As fontes não travam a primeira pintura: as reservas de mesma largura (home.css) seguram o texto até elas chegarem. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Gloock&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Gloock&display=swap" /></noscript>
    <link rel="preload" as="image" href="/art/brasil-inteiro/mapa-apagado.webp" type="image/webp" media="(prefers-reduced-motion: no-preference)" />
  </Fragment>

  <div class="bi" data-art="brasil-inteiro">
  <Header />

  <main>
    <!-- HERO · palco: o Brasil desenhado pelos 5.571 municípios; a luz sai de uma cidade e acende o país.
         O pôster (imagem estática) pinta primeiro e é o LCP; o canvas assume depois (scripts/brasil-inteiro/palco.ts).
         Com "reduzir movimento", o pôster aceso fica e o canvas nem carrega. -->
    <section class="bi-palco" aria-labelledby="hero-title">
      <!-- Duas colunas no desktop (texto | mapa, centrados na mesma altura); abaixo de 1100px o
           mapa sobe para cima do texto. O mapa vem primeiro no HTML por causa do celular. -->
      <div class="bi-palco__topo">
      <figure class="bi-mapa-fig">
        <div class="bi-mapa" data-estado="parado">
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset="/art/brasil-inteiro/mapa-aceso.webp" type="image/webp" />
            <img class="bi-mapa__poster" src="/art/brasil-inteiro/mapa-apagado.webp" alt="" width="1100" height="1074" fetchpriority="high" decoding="async" />
          </picture>
          <canvas class="bi-mapa__vivo" aria-hidden="true"></canvas>
          <span class="bi-mapa__origem" aria-hidden="true"><i></i>Sua cidade (ex.: Goiânia)</span>
        </div>
        <figcaption class="bi-mapa__legenda">
          <b>5.571 municípios</b>
          <span>Cada ponto é uma cidade do IBGE.</span>
          <span class="bi-mapa__legenda-extra">A cadeira do seu nicho vale para todas.</span>
        </figcaption>
      </figure>

      <div class="bi-palco__texto">
        <span class="bi-olho">Growth Partner · Tecnologia e tráfego por nossa conta</span>
        <h1 id="hero-title">Construímos sua venda&nbsp;online. Nosso lucro vem <em>da sua venda.</em></h1>
        <p class="bi-sub">
          A ROI Labs banca a tecnologia e o tráfego. Você entra com o produto
          e uma anuidade simbólica pela cadeira. O resto só é cobrado depois da
          venda, porque o nosso lucro é uma fração do seu.
        </p>
        <div class="bi-acoes">
          <a class="btn btn--primary" href="#candidatar">Aplicar para a cadeira</a>
          <a class="btn btn--whats" href={whatsHref} target="_blank" rel="noopener">Chamar no WhatsApp</a>
          <a class="bi-mais" href="#mecanica">Ver como funciona ↓</a>
        </div>
      </div>
      </div>

      <!-- Preço de entrada à vista logo depois das ações: quem chega já sabe quanto custa a cadeira.
           Valores do FAQ ("Quanto a ROI Labs fica?") e do JSON-LD; mudar lá muda aqui. -->
      <div class="wrap bi-preco-wrap">
        <div class="bi-preco" role="group" aria-label="Quanto custa a cadeira">
          <div class="bi-preco__valor">
            <span class="bi-preco__rot">Anuidade da cadeira</span>
            <p><b>R$ 2.640</b><span>/ano</span></p>
          </div>
          <p class="bi-preco__nota">
            Equivale a <b>R$ 220 por mês</b>. Sem setup, sem piso de venda e sem verba de mídia:
            o resto só é cobrado depois da venda.
          </p>
          <ul class="bi-preco__fatos" role="list">
            <li>1 cadeira por nicho no Brasil</li>
            <li class="bi-preco__aberta">Curadoria aberta</li>
          </ul>
        </div>
      </div>

      <!-- Vitrine: as cadeiras que já estão no ar. A pessoa passa no ritmo dela: setas, arrasto
           ou teclado (scripts/brasil-inteiro/vitrine.ts). -->
      <div class="bi-vitrine">
        <div class="wrap bi-vitrine__rot">
          <p><b>No ar agora.</b> Cada cadeira ocupada é uma operação de verdade, construída com a ROI Labs.</p>
          <div class="bi-vitrine__setas">
            <button class="bi-vitrine__seta" type="button" data-dir="-1" aria-label="Ver os sites anteriores">←</button>
            <button class="bi-vitrine__seta" type="button" data-dir="1" aria-label="Ver os próximos sites">→</button>
          </div>
        </div>
        <div class="bi-vitrine__janela">
          <ul class="bi-vitrine__trilho" role="list">
            {vitrine.map((v, i) => (
              <li class="bi-vitrine__item" style={`--i: ${i}`}>
                <a href={v.href} target="_blank" rel="noopener">
                  <img
                    src={`/art/brasil-inteiro/vitrine/${v.foto}.webp`}
                    alt={`Página inicial do site ${v.nome}`}
                    width="880"
                    height="550"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="bi-vitrine__leg">
                    <span>{v.nicho} · {v.nome}</span>
                    <span class="bi-vitrine__estado"><span>No ar</span><span class="bi-vitrine__abrir">Abrir site ↗</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <script>
      import { iniciarVitrine } from '../scripts/brasil-inteiro/vitrine';
      import { iniciarTeste } from '../scripts/brasil-inteiro/teste';

      const vitrine = document.querySelector<HTMLElement>('.bi-vitrine');
      if (vitrine) iniciarVitrine(vitrine);

      // Seção dos gates: o gate 03 vira o teste de quatro perguntas.
      const teste = document.querySelector<HTMLElement>('[data-teste]');
      if (teste) iniciarTeste(teste);

      // O mapa vivo (e os 22kb de coordenadas) só carrega depois que a página pintou.
      const caixa = document.querySelector<HTMLElement>('.bi-mapa');
      if (caixa && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ligar = () => import('../scripts/brasil-inteiro/palco').then((m) => m.iniciar(caixa));
        if ('requestIdleCallback' in window) requestIdleCallback(ligar, { timeout: 1500 });
        else addEventListener('load', ligar, { once: true });
      }
    </script>

    <!-- MANIFESTO -->
    <section class="section section--dark manifesto" aria-labelledby="manifesto-title">
      <div class="wrap manifesto__grid">
        <p class="manifesto__big" id="manifesto-title">
          Não somos agência.<br />
          Somos <em>sócios de performance</em> da sua operação digital.
        </p>
        <p class="manifesto__note">
          A ROI Labs é uma fábrica de infraestrutura de vendas. Construímos o
          ecossistema — site, SEO de alta intenção e uma equipe de vendas que
          atende e fecha a venda — que coloca fornecedores regionais de alto
          padrão na frente de quem já está pronto pra comprar. Sem fee de agência, sem projeto fechado: uma anuidade
          simbólica pela cadeira e o resto atrelado à venda.
        </p>
      </div>
    </section>

    <!-- MECÂNICA -->
    <section class="section section--light" id="mecanica" aria-labelledby="mecanica-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">A mecânica · três fases</span>
          <h2 id="mecanica-title">Risco nosso na largada. Lucro dividido na chegada.</h2>
        </div>

        <div class="steps">
          <article class="step">
            <span class="step__num">01 — Curadoria</span>
            <h3>Uma empresa por nicho</h3>
            <p>
              Selecionamos um único fornecedor de ponta por setor: produto
              excelente, presença online fraca. Você passa nos três gates de
              validação — ou a cadeira não abre.
            </p>
            <span class="step__tag">Gate de entrada</span>
          </article>

          <article class="step">
            <span class="step__num">02 — Construção</span>
            <h3>Máquina de tráfego orgânico</h3>
            <p>
              Montamos centenas de páginas de alta intenção — uma para cada
              combinação de produto, característica e cidade com busca real.
              Custo de tecnologia e tráfego é nosso.
            </p>
            <span class="step__tag">Custo da ROI Labs</span>
          </article>

          <article class="step">
            <span class="step__num">03 — Performance</span>
            <h3>Só ganhamos se você ganha</h3>
            <p>
              Quando as vendas chegam, dividimos. Nossa parte é variável e
              atrelada a SLA de estoque e despacho. A anuidade de R$ 2.640
              garante a cadeira exclusiva por um ano, renovável por entrega.
            </p>
            <span class="step__tag">Anuidade + % da venda</span>
          </article>
        </div>
      </div>
    </section>

    <!-- MAPA DE CADEIRAS (signature) -->
    <section class="section section--light" id="cadeiras" aria-labelledby="cadeiras-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">Escassez programada</span>
          <h2 id="cadeiras-title">Mapa de cadeiras</h2>
          <p class="section__lead">
            Uma cadeira por nicho no Brasil inteiro, renovável por desempenho.
            Quando uma fecha, ela sai do mapa — e o seu concorrente não senta nela.
            Cada cadeira do mapa é um produto de verdade, não um case.
          </p>
        </div>

        <!-- Duas divisões (28/09/2026): clientes e ROI Labs. O script ao vivo abaixo casa cada card
             com a linha do banco por `data-site` (siteUrl) e, sem site no banco, por `data-nicho` —
             NÃO por posição: a ordem das divisões não é a ordem (`ordem`) do banco. -->
        {divisoesDoMapa.map((d) => (
          <Fragment>
            <h3 class="map__subtitle">{d.titulo}</h3>
            <p class="map__sublead">{d.lead}</p>
            <ul class="map__grid map__grid--software" role="list">
              {d.cards.map((c) => (
                <li
                  class={`seat ${aceitaCandidatura(c) ? 'seat--open' : ''} ${ocupada(c) ? 'seat--taken' : ''}`}
                  data-site={c.siteUrl}
                  data-nicho={c.niche}
                >
                  {c.siteUrl ? (
                    <a class="seat__niche" href={c.siteUrl} target="_blank" rel="noopener">{c.niche} ↗</a>
                  ) : (
                    <span class="seat__niche">{c.niche}</span>
                  )}
                  <span class="seat__status">
                    <span class="seat__ring" aria-hidden="true"></span>
                    {' '}{ESTADO[c.estado] ?? c.estado}{c.nome ? ` · ${c.nome}` : ''}{c.rotulo === 'casa' ? ' · Da casa' : ''}
                  </span>
                </li>
              ))}
            </ul>
          </Fragment>
        ))}
        <p class="map__caption">
          Seu nicho não está no mapa? Então a cadeira dele está livre.
          <a href="#candidatar">Candidate-se →</a>
        </p>
      </div>
    </section>

    <script is:inline>
      // Mapa de cadeiras AO VIVO: busca o DB no navegador e sobrescreve o skeleton estático.
      // Casa card com linha por `siteUrl` (data-site) e, para a linha sem site no banco (a de
      // fitas adesivas, que nasceu no SEED de nicho), por `niche` (data-nicho). Até 28/09 casava
      // por ÍNDICE; com as divisões clientes/ROI Labs a ordem do documento deixou de ser a do
      // banco. Card sem par no banco (cadeira nova antes do seed, rótulo editado no /admin)
      // mantém o texto do skeleton: degrada limpo em vez de receber o dado do vizinho.
      // Falhou o fetch? mantém o skeleton inteiro.
      //
      // 012/T057b: o laço ATUALIZA, nunca cria <li>. Criar aqui duplicaria os cards que o
      // skeleton já desenhou.
      var ESTADO = { 'ocupada-vendavel': 'No ar', 'em-preparacao': 'Em preparação' };
      var chave = function (u) { return String(u || '').toLowerCase().replace(/\/+$/, ''); };
      fetch('https://app.roilabs.com.br/api/cadeiras')
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((cadeiras) => {
          var porSite = {};
          var porNicho = {};
          cadeiras.forEach((s) => {
            if (s.siteUrl) porSite[chave(s.siteUrl)] = s;
            if (s.niche) porNicho[s.niche] = s;
          });
          document.querySelectorAll('#cadeiras .map__grid .seat').forEach((li) => {
            const s = porSite[chave(li.dataset.site)] || porNicho[li.dataset.nicho];
            if (!s) return;
            // 012 FR-020: cadeira OCUPADA não é oferecida para candidatura. `s.open` sozinho
            // não basta — a API resolve as duas condições em `aceitaCandidatura`.
            li.classList.toggle('seat--open', !!s.aceitaCandidatura);
            li.classList.toggle('seat--taken', String(s.estado || '').indexOf('ocupada') === 0);
            const st = li.querySelector('.seat__status');
            if (!st) return;
            st.textContent = '';
            const ring = document.createElement('span');
            ring.className = 'seat__ring';
            ring.setAttribute('aria-hidden', 'true');
            st.appendChild(ring);
            // Legenda `estado · nome`, e o selo "Da casa" SÓ quando `rotulo === 'casa'`.
            // O nome sai do `status` do /admin ("Ocupada · Polaris IA"), o mesmo lugar de onde o
            // skeleton o extrai; mudar um sem o outro faz a legenda piscar.
            // ⚠️ FR-010a: `rotulo`, NUNCA `daCasa`.
            const nome = String(s.status || '').split('·').pop().trim();
            const texto = (ESTADO[s.estado] || s.estado) + (nome ? ' · ' + nome : '') + (s.rotulo === 'casa' ? ' · Da casa' : '');
            st.appendChild(document.createTextNode(' ' + texto));

            // O rótulo do nicho MUDA, e quem manda é o banco: sem isto, um rótulo editado no
            // /admin ficaria invisível até o próximo deploy.
            const alvo = li.querySelector('.seat__niche');
            if (alvo && s.niche) alvo.textContent = alvo.tagName === 'A' ? s.niche + ' ↗' : s.niche;
          });
        })
        .catch(() => {});
    </script>

    <!-- PROVA / MERCADO -->
    <section class="section section--dark" id="mercado" aria-labelledby="mercado-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">Leitura de mercado · Brasil</span>
          <h2 id="mercado-title">A demanda já existe. Falta quem a capture.</h2>
          <p class="section__lead">
            Não é aposta. A demanda do seu nicho é medida no Brasil inteiro antes
            de a cadeira abrir — como a de fitas adesivas personalizadas, abaixo:
            tem anunciante pagando até R$&nbsp;32,95 por clique para aparecer. A
            cadeira capta essa mesma busca sem pagar clique.
          </p>
        </div>

        <div class="readout" role="group" aria-label="Indicadores de demanda no Brasil">
          <div class="readout__bar">
            <span class="readout__dotrow" aria-hidden="true"><span></span><span></span><span></span></span>
            Google Keyword Planner · Brasil · ago/2026
          </div>
          <div class="readout__body">
            <div class="metric">
              <div class="metric__val">R$&nbsp;32,95<span class="unit">/clique</span></div>
              <div class="metric__key">o máximo que anunciantes pagam por um clique em "fitas adesivas personalizadas"</div>
            </div>
            <div class="metric">
              <div class="metric__val">R$ 0<span class="unit">mídia</span></div>
              <div class="metric__key">captação 100% orgânica, não compramos clique</div>
            </div>
            <div class="metric">
              <div class="metric__val">01<span class="unit">cadeira</span></div>
              <div class="metric__key">por nicho — o resto fica de fora</div>
            </div>
          </div>
        </div>
        <p class="prova__foot">
          Fonte: Google Ads Keyword Planner, Brasil, agosto de 2026 — lance de
          topo de página, faixa mais alta. Demanda validada antes do investimento.
        </p>

        <!-- Resultado entregue (não custo de concorrente). Números do Search Console da
             Use Aligner, cadeira ocupada. "Cliques" = visitas, NUNCA "vendas". -->
        <h3 class="prova__title">E quando alguém captura, é assim.</h3>
        <div class="readout" role="group" aria-label="Resultado orgânico da Use Aligner em 12 meses">
          <div class="readout__bar">
            <span class="readout__dotrow" aria-hidden="true"><span></span><span></span><span></span></span>
            Google Search Console · usealigner.com · 12 meses
          </div>
          <div class="readout__body">
            <div class="metric">
              <div class="metric__val"><span class="metric__num" data-flow="369000">369.000</span><span class="unit">vezes</span></div>
              <div class="metric__key">aparecendo nas buscas do Google</div>
            </div>
            <div class="metric">
              <div class="metric__val"><span class="metric__num" data-flow="4900">4.900</span><span class="unit">visitas</span></div>
              <div class="metric__key">vindas do Google, sem pagar anúncio</div>
            </div>
            <div class="metric">
              <div class="metric__val"><span class="metric__num" data-flow="4.8" data-decimals="1">4,8</span><span class="unit">posição</span></div>
              <div class="metric__key">média no Google — entre os 5 primeiros</div>
            </div>
          </div>
        </div>

        <script>
          // Números do readout rolam de 0 até o valor (NumberFlow, versão sem React) toda vez
          // que a caixa entra na tela; ao sair por inteiro, voltam a 0 sem animar (ninguém vê)
          // e rolam de novo na próxima passada. O texto estático do HTML continua na página, só escondido
          // da vista: é ele que robô de busca/IA e leitor de tela leem. Sem JS ou com
          // "reduzir movimento" ligado, nada muda — o número já aparece pronto.
          import 'number-flow';
          import { continuous } from 'number-flow';

          // A página tem dois .readout; o observado é o que contém os números.
          const nums = [...document.querySelectorAll<HTMLElement>('.readout [data-flow]')];
          const box = nums[0]?.closest('.readout');
          const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (box && nums.length && !calmo && 'IntersectionObserver' in window) {
            // Lento de propósito: o número grande precisa de tempo para pesar. Curva
            // ease-out suave (não expo), senão quase todo o giro acontece no começo e
            // parece rápido de novo. Mais de ~3s cansa, já que repete a cada passada.
            const ritmo = { duration: 2800, easing: 'cubic-bezier(0.33, 1, 0.68, 1)' };
            const flows = nums.map((el) => {
              const casas = Number(el.dataset.decimals ?? 0);
              const flow = document.createElement('number-flow');
              flow.setAttribute('aria-hidden', 'true');
              flow.locales = 'pt-BR';
              flow.format = { minimumFractionDigits: casas, maximumFractionDigits: casas };
              flow.plugins = [continuous];
              flow.spinTiming = ritmo;
              flow.transformTiming = ritmo;
              // Reserva a largura do valor final: sem isso a palavra ao lado ("vezes") anda
              // enquanto o número cresce de 0 até ele, e isso conta como deslocamento de layout.
              flow.style.display = 'inline-block';
              flow.style.minWidth = `${el.getBoundingClientRect().width}px`;
              el.before(flow);
              el.classList.add('metric__num--sr');
              flow.update(0);
              return { flow, alvo: Number(el.dataset.flow) };
            });

            // Rola com metade da caixa visível; zera só quando ela some de vez — zerar com a
            // caixa ainda meio visível mostraria o número pulando para 0.
            let rolou = false;
            let timers: number[] = [];
            new IntersectionObserver(([e]) => {
              if (!rolou && e.intersectionRatio >= 0.5) {
                rolou = true;
                timers = flows.map(({ flow, alvo }, i) => window.setTimeout(() => flow.update(alvo), i * 250));
              } else if (rolou && !e.isIntersecting) {
                rolou = false;
                timers.forEach(clearTimeout);
                flows.forEach(({ flow }) => {
                  flow.animated = false;
                  flow.update(0);
                  flow.animated = true;
                });
              }
            }, { threshold: [0, 0.5] }).observe(box);
          }
        </script>
        <p class="prova__foot">
          Fonte: Google Search Console de usealigner.com (alinhadores invisíveis),
          set/2025 a set/2026. Site começou do zero; tráfego 100% orgânico.
        </p>

      </div>
    </section>

    <!-- ICP: OS 3 GATES · opção B (escolhida em 28/09/2026): 01 e 02 são afirmação ("nós medimos"), estáticos;
         o 03 é um teste de 4 perguntas (scripts/brasil-inteiro/teste.ts). Sem JS, o cartão mostra os quatro
         pontos e o "não é pra você" como lista, com o botão de aplicar. -->
    <section class="section section--light bi-gates" id="cadeira-pra-voce" aria-labelledby="icp-title">
      <div class="wrap bi-gates__grade">
        <div>
          <span class="eyebrow">A cadeira é sua se…</span>
          <h2 id="icp-title">Três gates. Dois medimos nós. <em>O terceiro é você.</em></h2>
          <p class="section__lead">
            Não abrimos uma cadeira no escuro. Antes de o seu nicho ganhar
            cadeira, medimos a demanda e a brecha na busca. A peça que falta é o
            fornecedor certo.
          </p>
          <ul class="bi-medidos" role="list" aria-label="Os dois gates que a ROI Labs mede">
            <li class="bi-medido">
              <span class="bi-medido__num" aria-hidden="true">01</span>
              <b>Demanda comprovada <small>Nós medimos</small></b>
              <span>Busca real pelo seu nicho, medida no Keyword Planner do Google.</span>
            </li>
            <li class="bi-medido">
              <span class="bi-medido__num" aria-hidden="true">02</span>
              <b>Brecha na busca <small>Nós medimos</small></b>
              <span>No Google, só aparecem marketplaces genéricos. Espaço pra dominar.</span>
            </li>
          </ul>
          <a class="bi-simular" href="/simulador/">Quanto sobra pra você? Simule sua receita →</a>
        </div>

        <div class="bi-teste" data-teste>
          <div class="bi-teste__topo">
            <span class="bi-teste__rot">Gate 03 · Você</span>
            <span class="bi-teste__passo" data-passo>Fornecedor de ponta</span>
          </div>
          <div class="bi-teste__barras" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

          <div data-estatico>
            <p class="bi-teste__titulo">O produto e a logística que a demanda exige. A cadeira pede quatro pontos:</p>
            <ul class="bi-teste__lista" role="list">
              <li>Tem catálogo próprio e amplo no seu nicho.</li>
              <li>Aguenta estoque e despacho rápido, pronta-entrega de verdade.</li>
              <li>Produto forte, presença online fraca, e quer escalar.</li>
              <li>Topa exclusividade de cadeira atrelada a SLA.</li>
            </ul>
            <p class="bi-teste__nao">
              <b>Não é pra você se:</b> revende sem catálogo ou marca próprios · não consegue acompanhar um
              salto de demanda · procura agência de mídia paga com fee mensal · não quer compromisso de exclusividade.
            </p>
            <div class="bi-teste__respostas"><a class="btn btn--primary" href="#candidatar">Aplicar para a cadeira</a></div>
          </div>

          <div data-vivo hidden>
            <div data-fluxo>
              <p class="bi-teste__pergunta" data-pergunta aria-live="polite"></p>
              <div class="bi-teste__respostas">
                <button class="btn btn--primary" type="button" data-r="sim">Sim</button>
                <button class="btn bi-btn-escuro" type="button" data-r="nao">Ainda não</button>
              </div>
            </div>

            <div data-ok hidden>
              <p class="bi-teste__titulo" tabindex="-1">Gate 03 aceso. <em>A cadeira do seu nicho pode ser sua.</em></p>
              <p class="bi-teste__texto">Você marcou os quatro pontos que a cadeira pede. O próximo passo é a curadoria olhar o seu nicho.</p>
              <div class="bi-teste__respostas">
                <a class="btn btn--primary" href="#candidatar">Aplicar para a cadeira</a>
                <button class="bi-teste__refazer" type="button" data-refazer>Refazer o teste</button>
              </div>
            </div>

            <div data-talvez hidden>
              <p class="bi-teste__titulo" tabindex="-1">Pode não ser a hora ainda.</p>
              <p class="bi-teste__texto">A cadeira pede os quatro pontos, e ficou em aberto: <b data-aberto></b></p>
              <div class="bi-teste__respostas">
                <a class="btn btn--whats" href={whatsTeste} target="_blank" rel="noopener">Conversar mesmo assim</a>
                <button class="bi-teste__refazer" type="button" data-refazer>Refazer o teste</button>
              </div>
            </div>

            <p class="bi-teste__nota">
              Quatro perguntas, 30 segundos. As respostas não vão para nenhum formulário: servem só para você saber
              se a cadeira combina com o seu negócio.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--dark" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">Antes de candidatar</span>
          <h2 id="faq-title">As perguntas que todo fornecedor faz.</h2>
        </div>

        <div class="faq">
          <details class="faq__item">
            <summary>Quanto a ROI Labs fica?</summary>
            <p class="faq__a">
              Duas partes. A anuidade da cadeira: R$ 2.640 por ano (R$ 220/mês),
              que reserva o nicho só pra você no Brasil. E uma fração variável do
              que você vende, definida em contrato. Sem setup, sem piso de venda,
              sem verba de mídia: o grosso do nosso lucro é uma parte do seu.
            </p>
          </details>
          <details class="faq__item">
            <summary>Quem atende o cliente que chega pelo site?</summary>
            <p class="faq__a">
              A equipe de vendas da ROI Labs. Ela tira as dúvidas, fecha a venda
              e entrega a venda pronta para você. Quem comprou pode ficar na
              nossa carteira, e a equipe trabalha para esse cliente comprar de
              novo. <a href="/modelo/">Veja como funciona no modelo</a>.
            </p>
          </details>
          <details class="faq__item">
            <summary>E se eu já tenho site?</summary>
            <p class="faq__a">
              Melhor ainda. Não pedimos pra trocar nada: construímos por cima a
              camada de captação de alta intenção — as centenas de páginas de
              cauda longa — que o seu site institucional não cobre.
            </p>
          </details>
          <details class="faq__item">
            <summary>A exclusividade me prende em quê?</summary>
            <p class="faq__a">
              Você fica como o único fornecedor do seu nicho no Brasil por um ano,
              renovável. Em troca, mantém o SLA de estoque e despacho. Não
              cumprimos a nossa parte? Você sai — a cadeira é sua enquanto a
              gente entrega resultado.
            </p>
          </details>
          <details class="faq__item">
            <summary>Preciso de quanto estoque?</summary>
            <p class="faq__a">
              Não é volume gigante — é consistência. Capacidade de atender o
              aumento de pedidos que o tráfego traz, com pronta-entrega. É o que
              separa um fornecedor de ponta na curadoria.
            </p>
          </details>
          <details class="faq__item">
            <summary>E se não der resultado?</summary>
            <p class="faq__a">
              O risco de tecnologia e tráfego é todo nosso. O seu custo máximo é
              conhecido desde o primeiro dia: a anuidade de R$ 2.640. A parte
              variável só existe se você vender. O alinhamento é total: só
              crescemos juntos.
            </p>
          </details>
          <details class="faq__item">
            <summary>Quanto tempo até as vendas?</summary>
            <p class="faq__a">
              SEO orgânico maduro leva de 3 a 6 meses — a travessia do deserto.
              Por isso a exclusividade e a transparência: você sabe exatamente em
              que fase está, sem promessa de resultado da noite pro dia.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CANDIDATAR (close + form) -->
    <section class="section close" id="candidatar" aria-labelledby="close-title">
      <div class="wrap close__inner">
        <div>
          <span class="eyebrow close__eyebrow">Candidate-se</span>
          <h2 id="close-title">A próxima cadeira pode ser a do seu nicho.</h2>
          <p class="close__copy">
            Uma empresa por nicho senta nela e domina a busca do setor no Brasil.
            Anuidade simbólica, sem risco de tecnologia. Candidate-se antes do seu
            concorrente.
          </p>
          <p class="close__whats">
            <a class="btn btn--whats" href={whatsHref} target="_blank" rel="noopener">Chamar no WhatsApp agora</a>
          </p>
          <p class="close__fine">
            Prefere formulário? Resposta em até 48h úteis. Ou e-mail:
            <a href={apply}>roilabs.ia@gmail.com</a>
          </p>
        </div>

        <div class="form-card">
          <form class="form" action={CANDIDATURAS_ENDPOINT} method="POST">
            <input type="hidden" name="redirect" value="https://roilabs.com.br/obrigado/" />
            <input type="hidden" name="origem" />

            <div class="form__hp" aria-hidden="true">
              <label>Não preencha<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="form__row">
              <div class="field field--req">
                <label for="f-nome">Seu nome</label>
                <input id="f-nome" name="nome" type="text" required autocomplete="name" />
              </div>
              <div class="field field--req">
                <label for="f-empresa">Empresa</label>
                <input id="f-empresa" name="empresa" type="text" required autocomplete="organization" />
              </div>
            </div>

            <div class="form__row">
              <div class="field field--req">
                <label for="f-whats">WhatsApp</label>
                <input id="f-whats" name="whatsapp" type="tel" required placeholder="(DDD) 9____-____" autocomplete="tel" />
              </div>
              <div class="field">
                <label for="f-cidade">Cidade</label>
                <input id="f-cidade" name="cidade" type="text" placeholder="ex.: Goiânia" autocomplete="address-level2" />
              </div>
            </div>

            <div class="field field--req">
              <label for="f-cat">Seu nicho</label>
              <input id="f-cat" name="categoria" type="text" required maxlength="120" placeholder="ex.: móveis planejados" />
            </div>

            <div class="field">
              <label for="f-site">Site atual (opcional)</label>
              <input id="f-site" name="site" type="url" placeholder="https://" />
            </div>

            <div class="field">
              <label for="f-msg">Sobre sua operação (opcional)</label>
              <textarea id="f-msg" name="mensagem" placeholder="Catálogo, capacidade de estoque/despacho, o que já vende online…"></textarea>
            </div>

            <button class="btn btn--primary form__submit" type="submit">Enviar candidatura</button>
            <p class="form__note">Candidatar-se não custa nada nem compromete. Leva 1 minuto.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
